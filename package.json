{
  "name": "owia-anzeiger",
  "version": "1.0.0",
  "private": true,
  "description": "Ordnungswidrigkeiten-Anzeigen im ruhenden Verkehr an Ordnungsämter (Portal, PDF, E-Mail)",
  "engines": {
    "node": ">=22.18 <23"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "lint": "biome lint .",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test": "bash scripts/test-integration.sh",
    "check": "npm run typecheck && node scripts/check-syntax.cjs && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.5",
    "@fastify/static": "^10.1.7",
    "@fastify/view": "^11.1.1",
    "archiver": "^8.0.0",
    "ejs": "^3.1.10",
    "exifr": "^7.1.3",
    "fastify": "^5.12.7",
    "heic-convert": "^2.1.0",
    "imapflow": "^1.7.8",
    "jpeg-js": "^0.4.4",
    "mailparser": "^3.12.4",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.0.16",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/archiver": "^8.0.0",
    "@types/ejs": "^3.1.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3"
  }
}
