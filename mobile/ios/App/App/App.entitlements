<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: Links auf owia.net (u. a. der Anmeldelink aus der Login-Mail)
	     öffnen die App. Apple prüft https://owia.net/.well-known/apple-app-site-association
	     (APP_IOS_TEAM_ID auf dem Server). Die App-ID braucht dafür die Capability
	     „Associated Domains“ – bei automatischer Signierung setzt Xcode sie selbst. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:owia.net</string>
	</array>
</dict>
</plist>
