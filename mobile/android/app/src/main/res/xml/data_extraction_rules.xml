<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: weder Cloud-Backup noch Geräteumzug für App-Daten (Sitzungs-Cookie
     der WebView), passend zu allowBackup="false" im Manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
