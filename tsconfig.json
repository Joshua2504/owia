{
  "compilerOptions": {
    // Kein Build: tsx führt die Quellen direkt aus (CommonJS, package.json ohne
    // "type"). "preserve" + "bundler" bildet das ab und ersetzt das veraltete
    // node10-Resolving; die Laufzeit liest diese Optionen nicht.
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*"]
}
