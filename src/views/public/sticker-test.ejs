<style>
  /* Vorschau-SVGs kommen aus services/stickerSatz.ts (viewBox in mm). */
  .stk-box { max-width: 576px; }
  .stk-box svg { display: block; width: 100%; height: auto; border-radius: 4px; box-shadow: 0 0 0 1px #cfcfcf, 0 .3rem .8rem rgba(0, 0, 0, .12); }
  .stk-nr { font-variant-numeric: tabular-nums; }
  .stk-fav { white-space: nowrap; }
</style>

<%_ function karte(e) { _%>
  <div class="col-12 col-lg-6 col-xxl-4">
    <div class="card h-100<%= e.favorit ? ' border-warning' : '' %>" id="<%= e.slug %>">
      <div class="card-body">
        <div class="d-flex align-items-center gap-2 mb-3">
          <span class="badge text-bg-secondary stk-nr"><%= String(e.nr).padStart(2, '0') %></span>
          <h2 class="h6 mb-0"><%= e.name %></h2>
          <% if (angemeldet) { %>
            <form method="post" action="/sticker-test/favorit" class="ms-auto">
              <input type="hidden" name="slug" value="<%= e.slug %>">
              <button type="submit" class="btn btn-sm stk-fav <%= e.favorit ? 'btn-warning' : 'btn-outline-secondary' %>" aria-pressed="<%= e.favorit %>">
                <%= e.favorit ? '★ Favorit' : '☆ Favorit' %>
              </button>
            </form>
          <% } %>
        </div>
        <div class="stk-box"><%- e.svg %></div>
        <div class="d-flex align-items-start gap-2 mt-3">
          <p class="small text-muted mb-0"><%= e.idee %></p>
          <% if (angemeldet) { %>
            <a class="btn btn-sm btn-outline-primary ms-auto text-nowrap" href="/sticker?entwurf=<%= e.slug %>#sticker-form">Bögen erstellen</a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
<%_ } _%>

<div class="mb-4">
  <h1 class="h3 mb-1">Sticker-Vorlagen</h1>
  <p class="text-muted mb-0">
    <%= favoriten.length + andere.length %> Textvorlagen, hier im Format 96 × 50,8 mm (ablösbare Etiketten) –
    genau so, wie sie gedruckt werden; andere Etikettenformate setzt der Druck automatisch passend.
    Der QR-Code ist echt und führt zum Muster-Code. Beträge: Regelsatz des Tatbestands der Vorlage,
    bei allgemeinen Vorlagen als Beispiel „Parken auf dem Gehweg“ – beim Erstellen gilt der gewählte Verstoß.
  </p>
  <% if (!angemeldet) { %>
    <p class="mb-0 mt-2"><a href="/login?weiter=/sticker-test">Anmelden</a>, um Favoriten zu markieren und Bögen zu erstellen.</p>
  <% } else { %>
    <p class="mb-0 mt-2">Favoriten stehen hier oben und beim <a href="/sticker">Erstellen von Bögen</a> zuerst in der Auswahl.</p>
  <% } %>
</div>

<% if (favoriten.length) { %>
  <h2 class="h5 mb-3">★ Ihre Favoriten (<%= favoriten.length %>)</h2>
  <div class="row g-4 mb-5">
    <% favoriten.forEach(karte) %>
  </div>
  <h2 class="h5 mb-3">Weitere Vorlagen</h2>
<% } %>

<div class="row g-4">
  <% andere.forEach(karte) %>
</div>
