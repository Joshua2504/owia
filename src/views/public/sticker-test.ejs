    { name: 'Minimal', idee: 'Kürzeste Fassung – trägt auch auf 70 × 37 mm.', html: `
      <div class="stk">
        <div class="stk-text">
          <div class="stk-main">
            <p class="stk-riesig">Angezeigt.</p>
            <p class="stk-p">Von einer Privatperson, beim Ordnungsamt.</p>
          </div>
          <p class="stk-fine">Bitte werfen Sie diesen Zettel nicht auf den Boden.</p>
        </div>
        ${Q}
      </div>` },

    { name: 'Kein Knöllchen', idee: 'Stellt klar, dass der Zettel nicht vom Amt ist – schützt vor dem Vorwurf, ein Knöllchen vorzutäuschen.', html: `
      <div class="stk">
        <div class="stk-text">
          <div class="stk-main">
            <p class="stk-h">Das ist kein Knöllchen.</p>
            <p class="stk-p">Sondern der Hinweis, dass eine Privatperson Sie beim Ordnungsamt angezeigt hat. Ob Sie zahlen müssen (wahrscheinlich <b>${G}</b>), erfahren Sie per Post.</p>
          </div>
