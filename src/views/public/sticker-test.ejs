        </div>
        ${Q}
      </div>` },
  ]
%>

<div class="mb-4">
  <h1 class="h3 mb-1">Sticker-Entwürfe</h1>
  <p class="text-muted mb-0">
    20 Textentwürfe im Format 96 × 50,8 mm (ablösbare Etiketten), maßstäblich. Der QR-Code ist echt und
    führt zum Muster-Code. Beträge sind Regelsätze aus dem Bußgeldkatalog (Gehweg, Radweg, Feuerwehrzufahrt).
    Favoriten einfach per Nummer nennen.
  </p>
</div>

<div class="row g-4">
  <% S.forEach((s, i) => { const nr = String(i + 1).padStart(2, '0') %>
    <div class="col-12 col-lg-6 col-xxl-4">
      <div class="card h-100" id="sticker-<%= i + 1 %>">
        <div class="card-body">
          <div class="d-flex align-items-baseline gap-2 mb-3">
            <span class="badge text-bg-secondary stk-nr"><%= nr %></span>
            <h2 class="h6 mb-0"><%= s.name %></h2>
          </div>
          <div class="stk-box"><%- s.html %></div>
          <p class="small text-muted mt-3 mb-0"><%= s.idee %></p>
        </div>
      </div>
    </div>
  <% }) %>
</div>
