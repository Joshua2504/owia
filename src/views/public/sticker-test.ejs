<%_ function karte(e) { _%>
  <div class="col-12 col-lg-6 col-xxl-4">
    <div class="card h-100<%= e.favorit ? ' border-warning' : '' %>" id="<%= e.slug %>">
      <div class="card-body">
        <div class="d-flex align-items-center gap-2 mb-3">
          <span class="badge text-bg-secondary stk-nr"><%= String(e.nr).padStart(2, '0') %></span>
          <h2 class="h6 mb-0"><%= e.name %></h2>
          <% if (angemeldet) { %>
            <form method="post" action="/sticker-test/favorit" class="ms-auto">
              <input type="hidden" name="slug" value="<%= e.slug %>">
              <button type="submit" class="btn btn-sm stk-fav <%= e.favorit ? 'btn-warning' : 'btn-outline-secondary' %>" aria-pressed="<%= e.favorit %>">
                <%= e.favorit ? '★ Favorit' : '☆ Favorit' %>
              </button>
            </form>
          <% } %>
        </div>
        <div class="stk-box"><%- H[e.slug] %></div>
        <p class="small text-muted mt-3 mb-0"><%= e.idee %></p>
      </div>
    </div>
  </div>
<%_ } _%>

<div class="mb-4">
  <h1 class="h3 mb-1">Sticker-Entwürfe</h1>
  <p class="text-muted mb-0">
    <%= favoriten.length + andere.length %> Textentwürfe im Format 96 × 50,8 mm (ablösbare Etiketten), maßstäblich.
    Der QR-Code ist echt und führt zum Muster-Code. Beträge sind Regelsätze aus dem Bußgeldkatalog.
  </p>
  <% if (!angemeldet) { %>
    <p class="mb-0 mt-2"><a href="/login?weiter=/sticker-test">Anmelden</a>, um Favoriten zu markieren – sie stehen dann oben.</p>
  <% } %>
</div>

<% if (favoriten.length) { %>
  <h2 class="h5 mb-3">★ Ihre Favoriten (<%= favoriten.length %>)</h2>
  <div class="row g-4 mb-5">
    <% favoriten.forEach(karte) %>
  </div>
  <h2 class="h5 mb-3">Weitere Entwürfe</h2>
<% } %>

<div class="row g-4">
  <% andere.forEach(karte) %>
</div>
