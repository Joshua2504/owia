<div class="row justify-content-center">
  <div class="col-lg-10">
    <!-- Hero: eine Aussage, ein Button -->
    <div class="hero text-center mb-4">
      <span class="hero-kicker">Kostenlos · Datenschutzfreundlich · Direkt ans Ordnungsamt</span>
      <h1 class="display-5 fw-bold mb-3">Falschparker melden – kostenlos Anzeige erstatten</h1>
      <p class="lead text-body-secondary mb-4 mx-auto hero-lead">
        Fotos hochladen, Verstoß wählen, fertig. Tatort und Uhrzeit kommen aus den
        Bildern, die Anzeige geht ans zuständige Ordnungsamt.
      </p>
      <% if (currentUser) { %>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
          <form method="post" action="/anzeige/neu" class="m-0">
            <button type="submit" class="btn btn-primary btn-lg px-4">+ Neue Anzeige erstatten</button>
          </form>
          <a href="/anzeigen" class="btn btn-outline-secondary btn-lg px-4">Meine Anzeigen</a>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-primary btn-lg px-5 py-3 fw-semibold">
          Anmelden &amp; Anzeige erstatten
        </a>
      <% } %>
    </div>

    <!-- Akute Behinderung gehört ans Telefon, nicht in eine Anzeige → Ratgeber /falschparker-melden -->
    <div class="card shadow-sm mb-5"><div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
      <div class="flex-grow-1">
        <div class="fw-semibold">🚒 Feuerwehrzufahrt oder Rettungsweg gerade zugeparkt?</div>
        <div class="small text-muted">
          Dann lieber anrufen: Verkehrspolizei
          <a href="tel:+496921236360" class="text-nowrap">069 212-36360</a>
          oder Stadtpolizei <a href="tel:+496921244044" class="text-nowrap">069 212-44044</a> (24/7).
        </div>
      </div>
      <a href="/falschparker-melden" class="btn btn-outline-secondary btn-sm flex-shrink-0">Alle Nummern &amp; Tipps</a>
    </div></div>

    <!-- So funktioniert's (liefert Suchmaschinen Kontext) -->
    <section class="mb-5">
      <h2 class="h4 mb-3 text-center">So funktioniert's</h2>
      <div class="row g-3">
        <div class="col-md-4">
          <div class="step-card h-100">
            <div class="step-icon" aria-hidden="true">📸</div>
            <h3 class="h6 mb-1">1. Fotos hochladen</h3>
            <p class="small text-body-secondary mb-0">Kennzeichen und Situation sichtbar – Ort und Zeit liest die App aus den Bildern, auch für viele auf einmal.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="step-card h-100">
            <div class="step-icon" aria-hidden="true">📝</div>
            <h3 class="h6 mb-1">2. Verstoß wählen</h3>
            <p class="small text-body-secondary mb-0">Gehweg, Radweg, Feuerwehrzufahrt, Halteverbot … – das amtliche PDF entsteht automatisch.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="step-card h-100">
            <div class="step-icon" aria-hidden="true">📮</div>
            <h3 class="h6 mb-1">3. Wir verschicken</h3>
            <p class="small text-body-secondary mb-0">Wir prüfen und senden ans Ordnungsamt. Du bekommst eine Kopie und siehst Antworten in der App.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Öffentliche Kennzahlen (aggregiert, anonym) + Karte -->
    <% const stats = locals.stats || {} %>
    <section class="mb-5">
      <h2 class="h4 mb-3 text-center">Bisher gemeldet</h2>
      <div class="row g-2 mb-3 text-center">
        <div class="col-6 col-md-3"><div class="stat-tile">
          <div class="stat-tile-value"><%= stats.total || 0 %></div>
          <div class="stat-tile-label">Anzeigen versendet</div>
        </div></div>
        <div class="col-6 col-md-3"><div class="stat-tile">
          <div class="stat-tile-value"><%= stats.last30 || 0 %></div>
          <div class="stat-tile-label">letzte 30 Tage</div>
        </div></div>
        <div class="col-6 col-md-3"><div class="stat-tile">
          <div class="stat-tile-value"><%= stats.fotos || 0 %></div>
          <div class="stat-tile-label">Beweisfotos</div>
        </div></div>
        <div class="col-6 col-md-3"><div class="stat-tile">
          <div class="fw-bold"><%= stats.topVerstoss || '–' %></div>
          <div class="stat-tile-label">häufigster Verstoß</div>
        </div></div>
      </div>
      <p class="text-center small mb-3"><a href="/statistik">Statistik mit möglichen Bußgeldern →</a></p>
      <!-- Übersichtskarte: lädt Marker aus /api/public/reports, Kacheln aus /tiles/... -->
      <div id="overview-map" class="rounded border shadow-sm map-panel-lg"
           data-center-lat="<%= centerLat %>" data-center-lon="<%= centerLon %>"></div>
      <p class="text-muted small mt-2 mb-0">
        Anonymisierte Karte aller versendeten Anzeigen – keine personenbezogenen Daten,
        Fotos stark verpixelt.
      </p>
    </section>

    <!-- Unterstützte Städte + Newsletter-Anmeldung für neue Städte/PLZ -->
    <section class="mb-5" id="newsletter">
      <h2 class="h4 mb-3 text-center">Unterstützte Städte</h2>
      <div class="row g-3 justify-content-center">
        <% (locals.cities || []).forEach((city) => { %>
          <div class="col-md-4">
            <div class="card h-100 shadow-sm"><div class="card-body">
              <h3 class="h6 mb-1">📍 <%= city.name %></h3>
              <p class="small text-muted mb-0">
                Anzeigen gehen an: <%= city.ordnungsamt %>
              </p>
            </div></div>
          </div>
        <% }) %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm border-primary-subtle"><div class="card-body">
            <h3 class="h6 mb-1">✉️ Deine Stadt fehlt?</h3>
            <p class="small text-muted mb-2">
              Wir schalten laufend neue Städte und Postleitzahlgebiete frei. Trag dich
              ein und wir benachrichtigen dich, sobald es bei dir losgeht.
            </p>
            <form method="post" action="/newsletter" class="d-flex flex-column gap-2">
              <input type="email" name="email" class="form-control form-control-sm"
                     placeholder="deine@email.de" required autocomplete="email"
                     aria-label="E-Mail-Adresse für Benachrichtigungen">
              <div class="d-flex gap-2">
                <input type="text" name="plz" class="form-control form-control-sm"
                       placeholder="PLZ (optional)" inputmode="numeric" pattern="[0-9]{5}"
                       maxlength="5" autocomplete="postal-code" style="max-width:9rem"
                       aria-label="Postleitzahl (optional)"
                       title="5-stellige Postleitzahl">
                <button type="submit" class="btn btn-primary btn-sm text-nowrap flex-grow-1">Eintragen</button>
              </div>
              <%# Proof-of-Work-Captcha (lokal, kein externer Dienst) – löst beim
                  Absenden automatisch; Server-Prüfung in POST /newsletter. %>
              <altcha-widget challengeurl="/captcha" auto="onsubmit" hidelogo hidefooter
                             class="d-block"
                             strings="{&quot;label&quot;:&quot;Ich bin kein Roboter&quot;,&quot;verifying&quot;:&quot;Prüfung läuft …&quot;,&quot;verified&quot;:&quot;Bestätigt&quot;,&quot;error&quot;:&quot;Prüfung fehlgeschlagen. Bitte erneut versuchen.&quot;,&quot;expired&quot;:&quot;Prüfung abgelaufen. Bitte erneut versuchen.&quot;,&quot;waitAlert&quot;:&quot;Prüfung läuft – bitte einen Moment warten.&quot;}"></altcha-widget>
            </form>
            <p class="form-text small mt-2 mb-0">
              Die PLZ hilft uns zu entscheiden, wo es als Nächstes losgeht. Mit Klick auf
              „Eintragen" bekommst du eine Bestätigungs-Mail (Double-Opt-In). Abmeldung
              jederzeit über den Link in jeder E-Mail.
            </p>
          </div></div>
        </div>
      </div>
    </section>

    <%- include('../partials/hu-plaketten') %>

    <!-- FAQ: beantwortet die häufigsten Suchanfragen (auch als FAQPage-Schema unten) -->
    <%
    const faq = [
      ['Darf ich Falschparker überhaupt anzeigen?',
       'Ja. Jeder darf eine Ordnungswidrigkeit wie Falschparken beim Ordnungsamt anzeigen (Privatanzeige nach § 46 OWiG i.V.m. der StVO). Wichtig sind Beweisfotos, Tatort, Datum, Uhrzeit und das Kennzeichen – genau das erfasst OWiA-Anzeiger für dich.'],
      ['Was kostet die Anzeige eines Falschparkers?',
       'Nichts. OWiA-Anzeiger ist kostenlos. Auch beim Ordnungsamt entstehen dir als anzeigender Person keine Kosten.'],
      ['Welche Parkverstöße kann ich melden?',
       'Unter anderem: Parken auf dem Gehweg oder Radweg, im absoluten oder eingeschränkten Halteverbot, in zweiter Reihe, in Feuerwehrzufahrten, auf Behindertenparkplätzen, vor abgesenkten Bordsteinen, an Kreuzungen und auf der linken Fahrbahnseite.'],
      ['Welche Fotos brauche ich als Beweis?',
       'Am besten mehrere Fotos: eine Übersicht der Situation (z.B. blockierter Gehweg samt Umgebung) und eine Nahaufnahme mit lesbarem Kennzeichen. Fotografierst du denselben Verstoß über einen längeren Zeitraum mehrfach, belegt das die Dauer.'],
      ['Bleibe ich anonym?',
       'Gegenüber der Öffentlichkeit ja – die öffentliche Karte zeigt keine personenbezogenen Daten. Gegenüber dem Ordnungsamt nicht: Anonyme Anzeigen werden nicht bearbeitet, als Zeugin oder Zeuge musst du mit Name und Anschrift benannt sein.'],
      ['Was passiert nach dem Absenden?',
       'Wir prüfen deine Anzeige und senden sie mit allen Angaben und Beweisfotos per E-Mail an das zuständige Ordnungsamt – du erhältst eine Kopie. Antworten des Amts (z.B. Rückfragen oder der Ausgang des Verfahrens) siehst du direkt in der App.'],
    ]
    %>
    <section class="my-5">
      <h2 class="h4 mb-3 text-center">Häufige Fragen zum Melden von Falschparkern</h2>
      <div class="accordion" id="faq">
        <% faq.forEach(([q, a], i) => { %>
          <div class="accordion-item">
            <h3 class="accordion-header">
              <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                      data-bs-target="#faq-<%= i %>"><%= q %></button>
            </h3>
            <div id="faq-<%= i %>" class="accordion-collapse collapse" data-bs-parent="#faq">
              <div class="accordion-body small"><%= a %></div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <!-- Strukturierte Daten für Suchmaschinen (FAQ + Web-Anwendung) -->
    <script type="application/ld+json"><%- JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebApplication',
          name: 'OWiA-Anzeiger',
          url: (locals.appUrl || '') + '/',
          description: locals.metaDescription || '',
          applicationCategory: 'UtilityApplication',
          operatingSystem: 'Web',
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
          areaServed: (locals.cities || []).map((c) => ({ '@type': 'City', name: c.name })),
          inLanguage: 'de',
        },
        {
          '@type': 'FAQPage',
          mainEntity: faq.map(([q, a]) => ({
            '@type': 'Question',
            name: q,
            acceptedAnswer: { '@type': 'Answer', text: a },
          })),
        },
      ],
    }).replace(/</g, '\\u003c') %></script>
  </div>
</div>

<link rel="stylesheet" href="/public/vendor/leaflet.css">
<link rel="stylesheet" href="/public/vendor/leaflet.markercluster.css">
<script src="/public/vendor/leaflet.js"></script>
<script src="/public/vendor/leaflet.markercluster.js"></script>
<script src="/public/js/map-common.js"></script>
<script src="/public/js/overview-map.js"></script>
<script type="module" src="/public/vendor/altcha.min.js"></script>
