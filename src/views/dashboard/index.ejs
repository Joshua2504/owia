<%# .page-head (app.css): auf dem Handy stehen die Aktionen unter der
    Überschrift und teilen sich die volle Breite, ab sm rechts daneben. %>
<div class="page-head">
  <h2>Meine Anzeigen</h2>
  <div class="page-head-actions">
    <a class="btn btn-outline-secondary" href="/import">📸 Foto-Import</a>
    <% if (locals.trashCount) { %>
      <a class="btn btn-outline-secondary flex-grow-0" href="/papierkorb" title="Papierkorb">🗑 <span class="ms-1"><%= trashCount %></span></a>
    <% } %>
    <form method="post" action="/anzeige/neu" class="m-0 d-grid">
      <button type="submit" class="btn btn-primary">+ Neue Anzeige</button>
    </form>
  </div>
</div>

<% if (reports.length === 0) { %>
  <div class="card shadow-sm">
    <div class="card-body text-center py-5 text-muted">
      <p class="mb-3">Noch keine Anzeigen vorhanden.</p>
      <form method="post" action="/anzeige/neu" class="m-0">
        <button type="submit" class="btn btn-primary">Erste Anzeige erstatten</button>
      </form>
    </div>
  </div>
<% } else { %>
  <div class="card shadow-sm report-card">
    <%- include('../partials/report-table', { reports, imagesByReport, queueId: null, duplicateGroups, mergeBack }) %>
  </div>
<% } %>

<!-- Anonyme Übersichtskarte aller versendeter Anzeigen (gleiche Daten wie die Startseite). -->
<details class="card shadow-sm mt-4 mb-4">
  <summary class="p-3 fw-semibold">Übersichtskarte</summary>
  <div class="card-body">
    <h5 class="card-title mb-1">Übersicht</h5>
    <p class="text-muted small mb-3">
      Alle versendeten Anzeigen – anonymisiert, Fotos stark verpixelt.
      <span class="text-warning-emphasis">Deine eigenen Entwürfe sind orange markiert.</span>
    </p>
    <div id="overview-map" class="rounded border map-panel" data-include-own="1"></div>
  </div>
</details>


<link rel="stylesheet" href="/public/vendor/leaflet.css">
<link rel="stylesheet" href="/public/vendor/leaflet.markercluster.css">
<script src="/public/vendor/leaflet.js"></script>
<script src="/public/vendor/leaflet.markercluster.js"></script>
<script src="/public/js/overview-map.js"></script>
<script src="/public/js/report-table.js"></script>
<script src="/public/js/image-preview.js"></script>
