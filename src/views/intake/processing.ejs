<%# Zwischenseite, solange der Job 'intake.group' (routes/intake.ts) läuft.
    Lädt sich alle 3 s neu; ist der Batch fertig, kommt die Ergebnis-Übersicht. %>
<meta http-equiv="refresh" content="3">
<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Foto-Import – wird verarbeitet</h2>
  <a class="btn btn-outline-secondary btn-sm" href="/anzeigen">Zu den Anzeigen</a>
</div>
<div class="card shadow-sm">
  <div class="card-body">
    <p class="mb-2">
      Die Fotos werden im Hintergrund vorbereitet und zu Entwürfen gruppiert.
      Du musst nicht warten – die Entwürfe erscheinen nach und nach in deiner Anzeigen-Liste.
    </p>
    <% const pct = total ? Math.round((processed + assigned) * 50 / total) : 0 %>
    <div class="progress mb-2" role="progressbar" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100">
      <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: <%= pct %>%"></div>
    </div>
    <p class="text-muted small mb-0">
      <%= processed %> von <%= total %> Fotos vorbereitet · <%= assigned %> Entwürfen zugeordnet
    </p>
  </div>
</div>
