<%
// Ratgeber-Themenseite (routes/ratgeber.ts, Inhalte in config/ratgeber.ts).
// thema = RatgeberThema, zeilen = Bußgeld-Tabelle {tbnr, text, euro}.
const _crumbs = [['Startseite', '/'], ['Ratgeber', '/ratgeber'], [thema.kurz, '/' + thema.slug]]
%>
<div class="row justify-content-center">
  <article class="col-lg-9 seo-page">
    <%- include('../partials/seo-breadcrumb', { crumbs: _crumbs }) %>

    <header class="hero mb-4 text-start">
      <span class="hero-kicker"><%= thema.icon %> Ratgeber · Stand <%= stand.text %></span>
      <h1 class="display-6 fw-bold mb-3"><%= thema.h1 %></h1>
      <p class="lead text-body-secondary mb-4"><%- thema.lead %></p>
      <div class="d-flex flex-wrap gap-2">
        <%- include('../partials/seo-cta') %>
        <a href="#nummern" class="btn btn-outline-secondary">Nummern deiner Stadt</a>
      </div>
    </header>

    <nav class="seo-toc mb-5" aria-label="Inhalt">
      <strong class="d-block mb-2">Auf dieser Seite</strong>
      <ol class="mb-0">
        <% thema.abschnitte.forEach((a) => { %><li><a href="#<%= a.id %>"><%= a.h2 %></a></li><% }) %>
        <% if (zeilen.length) { %><li><a href="#bussgeld">Bußgeld laut Bußgeldkatalog</a></li><% } %>
        <li><a href="#nummern">Nummern & Online-Anzeige in deiner Stadt</a></li>
        <li><a href="#faq">Häufige Fragen</a></li>
      </ol>
    </nav>

    <% thema.abschnitte.forEach((a, i) => { %>
      <section id="<%= a.id %>" class="mb-5">
        <h2><%= a.h2 %></h2>
        <%- a.html %>
        <% if (a.id === 'anzeigen') { %><div class="mt-3"><%- include('../partials/seo-cta') %></div><% } %>
      </section>
      <% if (i === 0 && zeilen.length) { %>
        <section id="bussgeld" class="mb-5">
          <h2>Bußgeld laut Bußgeldkatalog</h2>
          <div class="table-responsive">
            <table class="table table-sm align-middle seo-table">
              <thead><tr><th scope="col">Tatbestand</th><th scope="col" class="text-end">Regelsatz</th></tr></thead>
              <tbody>
                <% for (const z of zeilen) { %>
                  <tr>
                    <td><%= z.text %> <span class="text-muted small text-nowrap">(TBNR <%= z.tbnr %>)</span></td>
                    <td class="text-end text-nowrap fw-semibold"><%= h.eur(z.euro) %></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <p class="small text-muted mb-0">
            Quelle: Bundeseinheitlicher Tatbestandskatalog (KBA), gilt bundesweit. Über den Betrag im Einzelfall
            entscheidet die Bußgeldbehörde. Alle Parkverstöße im <a href="/bussgeldkatalog-parken">Bußgeldkatalog Parken</a>.
          </p>
        </section>
      <% } %>
    <% }) %>

    <section id="nummern" class="mb-5">
      <h2>Nummern & Online-Anzeige in deiner Stadt</h2>
      <p>Wen du anrufst und wie die Anzeige ankommt, ist je nach Stadt verschieden:</p>
      <div class="row g-2">
        <% for (const s of staedte) { %>
          <div class="col-sm-6 col-md-4">
            <a class="card h-100 shadow-sm text-decoration-none seo-link-card" href="/<%= s.slug %>">
              <div class="card-body py-2">
                <div class="fw-semibold">📍 <%= s.name %></div>
                <div class="small text-muted">Falschparker melden in <%= s.kurz || s.name %></div>
              </div>
            </a>
          </div>
        <% } %>
      </div>
    </section>

    <section id="faq" class="mb-5">
      <h2>Häufige Fragen</h2>
      <%- include('../partials/seo-faq', { faq: thema.faq, faqId: 'faq-' + thema.slug }) %>
    </section>

    <aside class="mb-5" aria-label="Weitere Ratgeber">
      <h2 class="h5">Weitere Ratgeber</h2>
      <ul class="list-inline mb-0">
        <% for (const t of themen) { if (t.slug === thema.slug) continue %>
          <li class="list-inline-item mb-2"><a class="btn btn-sm btn-outline-secondary" href="/<%= t.slug %>"><%= t.icon %> <%= t.kurz %></a></li>
        <% } %>
        <li class="list-inline-item mb-2"><a class="btn btn-sm btn-outline-secondary" href="/bussgeldkatalog-parken">📖 Bußgeldkatalog Parken</a></li>
      </ul>
    </aside>

    <p class="text-muted small mb-0">
      Angaben ohne Gewähr, Stand <%= stand.text %>. Keine Rechtsberatung. Der OWiA-Anzeiger ist ein privates
      Angebot und kein offizielles Angebot einer Behörde.
    </p>

    <%- include('../partials/seo-schema', { crumbs: _crumbs, faq: thema.faq }) %>
  </article>
</div>
