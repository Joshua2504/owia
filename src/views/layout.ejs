<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <%# viewport-fit=cover: Vollbild-Seiten und die native App (config/mobileApp.ts)
      zeichnen bis unter Statusleiste/Notch – die Abstände setzt app.css (.is-app). %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0<%= (locals.bare || locals.appPlatform) ? ', viewport-fit=cover' : '' %>">
  <%# Theme vor dem ersten Rendern (kein Aufblitzen) – deshalb synchron und als
      erstes; common.js liefert window.OWIA für alle Seiten-Skripte, auch für
      die, die Views ohne defer mitten im Body laden. Keine Inline-Scripts:
      die CSP erlaubt nur Dateien unter /public/. %>
  <script src="/public/js/theme-init.js"></script>
  <script src="/public/js/common.js"></script>
  <title><%= locals.pageTitle || `${title} – OWiA-Anzeiger` %></title>
  <%# SEO: Beschreibung/Canonical/OG setzen nur öffentliche Seiten (z.B. Startseite);
      interne Seiten bleiben ohne (und sind per robots.txt ausgenommen). %>
  <% if (locals.metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
    <meta property="og:title" content="<%= locals.pageTitle || title %>">
    <meta property="og:description" content="<%= metaDescription %>">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="de_DE">
    <meta property="og:site_name" content="OWiA-Anzeiger">
    <% if (locals.canonical) { %>
      <meta property="og:url" content="<%= canonical %>">
      <link rel="canonical" href="<%= canonical %>">
      <%# Vorschaubild für Messenger/soziale Netze (absolute URL nötig). Erzeugt
          per Playwright-Screenshot; bei neuem Bild den Dateinamen ändern (1 Tag Cache). %>
      <meta property="og:image" content="<%= new URL(canonical).origin %>/public/og/owia-1200x630.png">
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta property="og:image:alt" content="OWiA-Anzeiger: Falschparker melden – kostenlos & online">
    <% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <% } %>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚗</text></svg>">
  <%# PWA: installierbar, Start auf der Startseite (/; Umleitung alter Starts in layout.js).
      iOS liest das Manifest-Icon nicht → apple-touch-icon. %>
  <link rel="manifest" href="/public/manifest.webmanifest">
  <meta name="theme-color" content="#f4f6f9" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)">
  <link rel="apple-touch-icon" href="/public/icons/icon-180.png">
  <link rel="stylesheet" href="/public/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="/public/css/app.css">
</head>
<%# embed: Seite läuft im Editor-Modal der Anzeigen-Liste (report-modal.js) –
    ohne Navigation, Footer und Cookie-Hinweis (die zeigt die umgebende Seite). %>
<%# bare: Vollbild-Seiten wie die Kamera (/kamera) – ebenfalls ohne Navigation. %>
<% const _bare = !!locals.bare %>
<% const _embed = !!locals.embed || _bare %>
<%# has-tabbar: eingeloggt auf dem Handy Tab-Leiste unten statt Hamburger/Footer (app.css). %>
<% const _tabbar = !!currentUser && !_embed %>
<body class="<%= [_bare ? 'is-embed is-bare' : (_embed ? 'is-embed' : ''), locals.appPlatform ? `is-app is-app-${locals.appPlatform}` : '', _tabbar ? 'has-tabbar' : ''].filter(Boolean).join(' ') %>"<%= isAdmin ? ' data-admin' : '' %><%= currentUser ? ' data-user' : '' %>>
  <%
    // Aktive Seite in der Navigation: Präfix-Vergleich auf den Pfad (viewData).
    const _path = locals.currentPath || ''
    const _act = (...prefixes) => prefixes.some((p) => _path === p || _path.startsWith(p + '/')) ? ' active' : ''
    const _adminLinks = [
      ['/admin/anzeigen', 'Prüfung'], ['/versand', 'Versand'], ['/admin/newsletter', 'Newsletter'],
      ['/admin/benutzer', 'Benutzer'], ['/admin/analyse', 'Analyse'], ['/admin/aufrufe', 'Aufrufe'],
    ]
    const _adminActive = _adminLinks.some(([href]) => _act(href))
  %>
  <% if (!_embed) { %>
  <nav class="navbar navbar-expand-lg sticky-top site-nav" id="site-nav">
    <%# Menü immer volle Breite (rechtsbündig), wie auf den Listen-Seiten. %>
    <div class="container-fluid px-3 px-xl-4">
      <a class="navbar-brand site-brand" href="/"><span class="site-brand-mark" aria-hidden="true">🚗</span><span class="site-brand-text">OWiA-Anzeiger</span><% if (_tabbar && _path !== '/' && locals.title) { %><span class="site-page-title"><%= title %></span><% } %></a>
      <div class="d-flex align-items-center gap-1 ms-auto order-lg-last">
        <button type="button" id="theme-toggle" class="btn btn-link nav-link px-2"
                title="Hell/Dunkel umschalten" aria-label="Farbschema umschalten">🌙</button>
        <% if (currentUser) { %>
          <div class="dropdown">
            <button class="btn btn-link nav-link px-1 d-flex align-items-center gap-2" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="Konto-Menü">
              <span class="site-nav-avatar" aria-hidden="true"><%= String(currentUser.name || currentUser.email || '?').trim().charAt(0).toUpperCase() %></span>
              <span class="d-none d-xl-inline"><%= currentUser.name %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><h6 class="dropdown-header text-truncate site-nav-email"><%= currentUser.email %></h6></li>
              <li><a class="dropdown-item" href="/einstellungen">Einstellungen</a></li>
              <li><a class="dropdown-item" href="/papierkorb">Papierkorb</a></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form method="post" action="/logout" class="m-0">
                  <button type="submit" class="dropdown-item">Abmelden</button>
                </form>
              </li>
            </ul>
          </div>
        <% } else { %>
          <a class="btn btn-primary btn-sm ms-1" href="/login">Anmelden</a>
        <% } %>
        <% if (currentUser) { %>
          <button class="navbar-toggler ms-1" type="button" data-bs-toggle="collapse" data-bs-target="#nav"
                  aria-controls="nav" aria-expanded="false" aria-label="Menü">
            <span class="navbar-toggler-icon"></span>
          </button>
        <% } %>
      </div>
      <% if (currentUser) { %>
      <div class="collapse navbar-collapse" id="nav">
        <ul class="navbar-nav ms-auto me-lg-2 align-items-lg-center gap-lg-1">
          <li class="nav-item"><a class="nav-link<%= _act('/anzeigen', '/anzeige') %>" href="/anzeigen">Meine Anzeigen</a></li>
          <li class="nav-item"><a class="nav-link<%= _act('/import') %>" href="/import">Foto-Import</a></li>
          <li class="nav-item d-lg-none"><a class="nav-link<%= _act('/kamera') %>" href="/kamera">Kamera</a></li>
          <li class="nav-item"><a class="nav-link<%= _act('/sticker') %>" href="/sticker">Sticker</a></li>
          <% if (isAdmin) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle<%= _adminActive ? ' active' : '' %>" href="#" role="button"
                 data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
              <ul class="dropdown-menu dropdown-menu-lg-end">
                <% for (const [href, label] of _adminLinks) { %>
                  <li><a class="dropdown-item<%= _act(href) %>" href="<%= href %>"><%= label %></a></li>
                <% } %>
              </ul>
            </li>
          <% } %>
          <li class="nav-item site-nav-cta ms-lg-2">
            <form method="post" action="/anzeige/neu" class="m-0">
              <button type="submit" class="btn btn-primary btn-sm px-3">+ Neue Anzeige</button>
            </form>
          </li>
        </ul>
      </div>
      <% } %>
    </div>
  </nav>
  <% } %>

  <%# wide: Listen-Seiten nutzen die volle Bildschirmbreite (große Tabellen). %>
  <main class="<%= _bare ? 'bare-main' : _embed ? 'container-fluid py-3' : (locals.wide ? 'container-fluid px-3 px-xl-4 py-4' : 'container py-4') %>">
    <% if (flash) { %>
      <div id="flash-message" class="alert alert-<%= flash.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
      </div>
    <% } %>

    <%- body %>
  </main>
  <% if (!_embed) { %>

  <!-- Cookie-Hinweis: rein informativ, da ausschließlich technisch notwendige
       Cookies (Sitzung + Statusmeldung) genutzt werden – keine Einwilligung
       erforderlich (§ 25 Abs. 2 TTDSG). Bestätigung merkt sich localStorage. -->
  <div id="cookie-notice" class="cookie-notice d-none" role="region" aria-label="Cookie-Hinweis">
    <div class="cookie-notice-box">
      <span>
        🍪 Nur <strong>technisch notwendige</strong> Cookies (Anmeldung &amp; Statusmeldungen) – kein Tracking, keine Werbung.
        <a href="/datenschutz">Datenschutz</a>
      </span>
      <button type="button" id="cookie-notice-ok" class="btn btn-primary btn-sm">Verstanden</button>
    </div>
  </div>
  <footer class="site-footer">
    <div class="container">
      <nav aria-label="Rechtliches und Informationen">
        <a href="/statistik">Statistik</a>
        <a href="/analyse">Analyse</a>
        <a href="/ratgeber">Ratgeber</a>
        <a href="/bussgeldkatalog-parken">Bußgeldkatalog Parken</a>
        <a href="/falschparker-melden-frankfurt">Falschparker melden in Frankfurt</a>
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="/nutzungsbedingungen">Nutzungsbedingungen</a>
      </nav>
    </div>
  </footer>
  <% if (_tabbar) { %>
  <%
    // Tab-Leiste (nur Handy, app.css .app-tabbar): die vier Hauptziele + „Mehr"
    // als Bottom-Sheet (Bootstrap-Offcanvas). Kamera groß in der Mitte.
    const _ico = (d) => `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`
    const _tabs = [
      ['/', 'Start', '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>', _path === '/'],
      ['/anzeigen', 'Anzeigen', '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>', !!_act('/anzeigen', '/anzeige', '/papierkorb')],
      ['/kamera', 'Kamera', '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>', false],
      ['/import', 'Import', '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>', !!_act('/import')],
    ]
    const _mehrAktiv = !!_act('/sticker', '/einstellungen', '/statistik', '/analyse', '/impressum', '/datenschutz', '/nutzungsbedingungen', '/falschparker-melden-frankfurt', '/ratgeber', '/bussgeldkatalog-parken') || _adminActive
  %>
  <nav class="app-tabbar" aria-label="App-Navigation">
    <% for (const [href, label, d, aktiv] of _tabs) { %>
      <a href="<%= href %>" class="app-tab<%= href === '/kamera' ? ' app-tab-cam' : '' %><%= aktiv ? ' active' : '' %>"<%= aktiv ? ' aria-current="page"' : '' %>>
        <span class="app-tab-icon"><%- _ico(d) %></span><span class="app-tab-label"><%= label %></span>
      </a>
    <% } %>
    <button type="button" class="app-tab<%= _mehrAktiv ? ' active' : '' %>" data-bs-toggle="offcanvas" data-bs-target="#app-mehr" aria-controls="app-mehr">
      <span class="app-tab-icon"><%- _ico('<line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>') %></span><span class="app-tab-label">Mehr</span>
    </button>
  </nav>

  <div class="offcanvas offcanvas-bottom app-sheet" tabindex="-1" id="app-mehr" aria-labelledby="app-mehr-titel">
    <div class="app-sheet-grip" aria-hidden="true"></div>
    <div class="offcanvas-header">
      <span class="site-nav-avatar" aria-hidden="true"><%= String(currentUser.name || currentUser.email || '?').trim().charAt(0).toUpperCase() %></span>
      <div class="flex-grow-1 min-w-0">
        <h2 class="h6 mb-0 text-truncate" id="app-mehr-titel"><%= currentUser.name || 'Mein Konto' %></h2>
        <div class="small text-body-secondary text-truncate"><%= currentUser.email %></div>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Schließen"></button>
    </div>
    <div class="offcanvas-body pt-0">
      <% const _gruppen = [
           [null, [['/sticker', '🏷️', 'Sticker'], ['/papierkorb', '🗑️', 'Papierkorb'], ['/einstellungen', '⚙️', 'Einstellungen']]],
           isAdmin ? ['Admin', _adminLinks.map(([href, label]) => [href, { '/admin/anzeigen': '✅', '/versand': '📤', '/admin/newsletter': '📰', '/admin/benutzer': '👥', '/admin/analyse': '🔬', '/admin/aufrufe': '📈' }[href] || '🛠️', label])] : null,
           ['Infos', [['/statistik', '📊', 'Statistik'], ['/analyse', '🔎', 'Analyse'], ['/ratgeber', '📚', 'Ratgeber'], ['/falschparker-melden-frankfurt', '📞', 'Falschparker melden in Frankfurt']]],
           ['Rechtliches', [['/impressum', '', 'Impressum'], ['/datenschutz', '', 'Datenschutz'], ['/nutzungsbedingungen', '', 'Nutzungsbedingungen']]],
         ].filter(Boolean) %>
      <% for (const [titel, links] of _gruppen) { %>
        <% if (titel) { %><div class="app-sheet-label"><%= titel %></div><% } %>
        <div class="list-group app-sheet-list">
          <% for (const [href, icon, label] of links) { %>
            <a href="<%= href %>" class="list-group-item list-group-item-action<%= _act(href) %>">
              <% if (icon) { %><span class="app-sheet-icon" aria-hidden="true"><%= icon %></span><% } %><span class="flex-grow-1"><%= label %></span><span class="app-action-chev" aria-hidden="true">›</span>
            </a>
          <% } %>
        </div>
      <% } %>
      <form method="post" action="/logout" class="m-0 mt-3">
        <button type="submit" class="btn btn-outline-danger w-100">Abmelden</button>
      </form>
    </div>
  </div>
  <% } %>
  <button type="button" id="back-to-top" class="btn back-to-top" aria-label="Nach oben" title="Nach oben" hidden>↑</button>
  <% } %>

  <%# layout.js: Service Worker, Flash, Cookie-Hinweis, Theme-Umschalter und
      die data-confirm-Rückfragen (Ersatz für onsubmit/onclick="return confirm"). %>
  <script src="/public/js/layout.js"></script>
  <%# Native App: Deep Links aus Mails/QR-Codes in der WebView öffnen (app-bridge.js). %>
  <% if (locals.appPlatform) { %><script src="/public/js/app-bridge.js"></script><% } %>
  <script src="/public/vendor/bootstrap.bundle.min.js"></script>
  <script src="/public/js/address-autocomplete.js"></script>
  <%# Alle Auswahllisten (select.form-select) durchsuchbar machen. %>
  <script src="/public/js/searchable-select.js"></script>
  <% if (currentUser) { %><script src="/public/js/versand-mini.js"></script><% } %>
</body>
</html>
