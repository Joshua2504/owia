          description: locals.metaDescription || '',
          inLanguage: 'de-DE',
          dateModified: locals.stand?.iso,
          about: { '@type': 'City', name: 'Frankfurt am Main', sameAs: 'https://www.wikidata.org/wiki/Q1794' },
          breadcrumb: { '@id': (locals.canonical || '') + '#breadcrumb' },
          isPartOf: { '@type': 'WebSite', name: 'OWiA-Anzeiger', url: (locals.appUrl || '') + '/' },
        },
        {
          '@type': 'BreadcrumbList',
          '@id': (locals.canonical || '') + '#breadcrumb',
          itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Startseite', item: (locals.appUrl || '') + '/' },
            { '@type': 'ListItem', position: 2, name: 'Falschparker melden in Frankfurt', item: locals.canonical || '' },
          ],
        },
        {
          '@type': 'FAQPage',
          mainEntity: _faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
        },
      ],
    }).replace(/</g, '\\u003c') %></script>
  </article>
</div>
