<%
const tattag = h.tattage(report, { long: true })
const tatzeit = h.uhrzeit(report) ? h.uhrzeit(report) + ' Uhr' : '—'
const isVersendet = report.status === 'versendet'
const isEntwurf = report.status === 'entwurf'
const images = locals.images || []
const complete = locals.complete
// Städte mit amtlichem Formular -> PDF; ohne Formular (z.B. Bad Soden-Salmünster)
// -> rohe E-Mail mit Fotos/Karte im Anhang (kein PDF). Portal-Städte (Frankfurt,
// Wiesbaden, Mainz) -> Online-Formular der Stadt, ebenfalls kein PDF.
const isPortal = !!(locals.city && locals.city.portal)
const hasForm = !!(locals.city && locals.city.pdfForm) && !isPortal
const versandLabel = {
  gedruckt: 'selbst gedruckt / per Post',
  selbst_email: 'selbst per E-Mail',
  system_email: 'von uns per E-Mail',
}[report.versand_art] || ''
%>

<div class="row justify-content-center">
  <div class="col-lg-7">
    <%# Überschrift und Aktionen stapeln auf dem Handy – nebeneinander bleibt für
        „Anzeige OWiA-123456" plus zwei Schaltflächen kein Platz. %>
    <div class="page-head">
      <h2>Anzeige <code><%= report.aktenzeichen || `#${report.id}` %></code></h2>
      <div class="page-head-actions">
        <% if (isEntwurf) { %>
          <a href="/anzeige/<%= report.aktenzeichen %>/bearbeiten" class="btn btn-outline-primary btn-sm">✎ Bearbeiten</a>
        <% } %>
        <a href="/anzeigen" class="btn btn-outline-secondary btn-sm tabbar-dup">← Übersicht</a>
      </div>
    </div>

    <%# Portal-Städte: Zusammenfassung des Online-Formulars direkt oben anzeigen. %>
    <% let _portalPdf = null
       for (const _rep of (locals.replies || [])) for (const _a of ((locals.attachmentsByReply || {})[_rep.id] || []))
         if (!_portalPdf && /-Portal-Zusammenfassung\.pdf$/.test(_a.original_filename || '')) _portalPdf = { rep: _rep, att: _a } %>
    <% if (_portalPdf) { const _url = `/anzeige/${report.aktenzeichen}/reply/${_portalPdf.rep.id}/attachment/${_portalPdf.att.id}` %>
      <div class="card shadow-sm mb-4 border-success">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span>✅ Abschluss-Beleg des Portals</span>
          <a class="btn btn-sm btn-outline-secondary" href="<%= _url %>">⬇ PDF</a>
        </div>
        <iframe src="<%= _url %>?inline=1" title="Portal-Zusammenfassung" class="w-100 border-0" style="height:70vh"></iframe>
      </div>
    <% } %>

    <div class="card shadow-sm mb-4">
      <div class="card-body">
        <%# .detail-list (app.css): auf dem Handy Beschriftung und Wert in einer Zeile. %>
        <dl class="row mb-0 detail-list">
          <dt class="col-sm-4">Aktenzeichen</dt>
          <dd class="col-sm-8"><code><%= report.aktenzeichen || '—' %></code></dd>

          <dt class="col-sm-4">Kennzeichen</dt>
          <dd class="col-sm-8"><% if (report.kennzeichen) { %><%- h.plate(report.kennzeichen, report.kennzeichen_land) %><% } else { %>—<% } %></dd>

          <% const _fz = [report.fahrzeug_typ, [report.fahrzeug_marke, report.fahrzeug_modell].filter(Boolean).join(' '), report.fahrzeug_farbe].filter(Boolean).join(', ') %>
          <% if (_fz) { %>
            <dt class="col-sm-4">Fahrzeug</dt>
            <dd class="col-sm-8"><%= _fz %></dd>
          <% } %>

          <dt class="col-sm-4">Tattag</dt>
          <dd class="col-sm-8"><%= tattag %></dd>

          <dt class="col-sm-4">Tatzeit</dt>
          <dd class="col-sm-8"><%= tatzeit %></dd>

          <dt class="col-sm-4">Tatort</dt>
          <dd class="col-sm-8"><%= report.tatort || '—' %></dd>

          <dt class="col-sm-4">Verstoßart</dt>
          <dd class="col-sm-8"><%= report.verstoss_art || '—' %><% if (report.verstoss_variante) { %> <span class="text-muted">(genauer: <%= report.verstoss_variante %>)</span><% } %></dd>

          <% if (report.beschreibung) { %>
            <dt class="col-sm-4">Beschreibung</dt>
            <dd class="col-sm-8"><%= report.beschreibung %></dd>
          <% } %>

          <% if (report.behinderung === 1 || report.behinderung === 0) { %>
            <dt class="col-sm-4">Jemand behindert?</dt>
            <dd class="col-sm-8">
              <%= report.behinderung === 1 ? 'Ja' : 'Nein' %>
              <% if (report.behinderung === 1 && report.behinderung_text) { %>
                <span class="text-muted">– <%= report.behinderung_text %></span>
              <% } %>
            </dd>
          <% } %>

          <dt class="col-sm-4">Status</dt>
          <dd class="col-sm-8">
            <%- h.statusBadge(report.status) %>
            <% if (isVersendet && versandLabel) { %><span class="text-muted small ms-1">(<%= versandLabel %>)</span><% } %>
          </dd>
        </dl>
      </div>
    </div>

    <% if (images.length > 0) { %>
      <div class="card shadow-sm mb-4">
        <div class="card-header">Beweisfotos (<%= images.length %>)</div>
        <div class="card-body">
          <div class="row g-2 g-md-3">
            <% for (const img of images) { %>
              <div class="col-4">
                <%# Vorschaubild statt Vollbild (lädt ein Bruchteil der Daten);
                    Hover = Vorschau/Lupe, Klick = groß (image-preview.js). %>
                <img src="/anzeige/<%= report.aktenzeichen %>/image/<%= img.id %>/thumb.jpg?v=<%= img.v %>"
                     class="img-fluid rounded border w-100" alt="Beweisfoto" loading="lazy" decoding="async"
                     style="cursor:zoom-in;aspect-ratio:4/3;object-fit:cover"
                     data-full-src="/anzeige/<%= report.aktenzeichen %>/image/<%= img.id %>?v=<%= img.v %>"
                     title="Klick: groß anzeigen">
                <% if (img.original_filename && img.original_filename !== img.filename) { %>
                  <a href="/anzeige/<%= report.aktenzeichen %>/image/<%= img.id %>?original=1"
                     class="d-block small text-muted mt-1">Original herunterladen</a>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      </div>

    <% } %>

    <%- include('../partials/sticker-card', { report, stickers: locals.stickers || [], loesenMinuten: locals.stickerLoesenMinuten }) %>

    <% const replies = locals.replies || [] %>
    <% const attachmentsByReply = locals.attachmentsByReply || {} %>
    <% if (replies.length || isVersendet) { %>
      <div class="card shadow-sm mb-4 border-primary">
        <div class="card-header">📨 Nachrichtenverlauf mit dem Ordnungsamt</div>
        <div class="card-body">
          <% if (!replies.length) { %>
            <p class="text-muted small mb-0">Noch keine Nachrichten gespeichert.</p>
          <% } %>
          <% for (const rep of replies) { %>
            <% const out = rep.direction === 'out' %>
            <div class="mb-3 p-2 rounded <%= out ? 'bg-body-tertiary border-start border-4 border-secondary' : 'border-start border-4 border-primary' %>">
              <div class="small text-muted mb-1">
                <strong><%= out ? 'Du / OWiA-Anzeiger' : (rep.from_address || 'Ordnungsamt') %></strong>
                <% if (rep.received_at) { %>· <%= new Date(rep.received_at).toLocaleString('de-DE') %><% } %>
                <% if (rep.subject) { %><br><%= rep.subject %><% } %>
              </div>
              <div style="white-space:pre-wrap"><%= rep.body_text || '(kein Text)' %></div>
              <% for (const att of (attachmentsByReply[rep.id] || [])) { %>
                <a class="btn btn-sm btn-outline-secondary mt-2 me-1"
                   href="/anzeige/<%= report.aktenzeichen %>/reply/<%= rep.id %>/attachment/<%= att.id %>">
                  📎 <%= att.original_filename %><% if (att.size_bytes) { %> (<%= Math.round(att.size_bytes / 1024) %> KB)<% } %>
                </a>
              <% } %>
            </div>
          <% } %>

          <% if (isVersendet) { %>
            <!-- Antwort ans Ordnungsamt direkt aus der App (Nutzer in Kopie). -->
            <form method="post" action="/anzeige/<%= report.aktenzeichen %>/message" class="mt-3">
              <label class="form-label small">Nachricht ans Ordnungsamt (z.&nbsp;B. Antwort auf eine Rückfrage)</label>
              <textarea name="text" class="form-control mb-2" rows="4" maxlength="10000" required
                        placeholder="Sehr geehrte Damen und Herren, …"></textarea>
              <button type="submit" class="btn btn-primary btn-sm"
                      data-confirm="Nachricht jetzt ans Ordnungsamt senden?">
                📤 Senden
              </button>
              <span class="form-text ms-2">Wird von <%= locals.mailFrom || 'unserem Postfach' %> gesendet<%= locals.ccSelf ? ', du erhältst eine Kopie' : '' %>.</span>
            </form>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (isEntwurf) { %>
      <% if (report.ablehnung_grund) { %>
        <div class="alert alert-warning">
          <strong>Die Prüfung hat die Anzeige zurückgegeben:</strong>
          <%= report.ablehnung_grund %><br>
          Bitte den Entwurf anpassen und erneut einreichen.
        </div>
      <% } %>
      <% if (locals.verjaehrt) { %>
        <div class="alert alert-danger">
          ⌛ <strong>Verjährt:</strong> Die Tat liegt mehr als drei Monate zurück
          (§ 26 Abs. 3 StVG). Das Ordnungsamt kann sie nicht mehr ahnden – die
          Anzeige kann daher nicht mehr eingereicht werden.
        </div>
      <% } %>
      <% if (!complete) { %>
        <div class="alert alert-warning">
          Es fehlen noch Pflichtangaben. Bitte zuerst
          <a href="/anzeige/<%= report.aktenzeichen %>/bearbeiten" class="alert-link">den Entwurf vervollständigen</a>,
          dann kann die Anzeige eingereicht werden.
        </div>
      <% } %>
      <% if (!locals.profileComplete) { %>
        <div class="alert alert-warning">
          Dein Profil ist unvollständig. Bitte hinterlege
          <a href="/einstellungen" class="alert-link">Name und Anschrift in den Einstellungen</a> –
          anonyme Anzeigen werden vom Ordnungsamt nicht bearbeitet.
        </div>
      <% } %>

      <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div>
            <h6 class="mb-1">Zur Prüfung einreichen</h6>
            <p class="small text-muted mb-1">
              Die Anzeige wird von uns geprüft und danach per E-Mail an das
              <%= city.ordnungsamt %> verschickt –
              <%= hasForm ? 'mit ausgefülltem PDF-Formular' : 'mit den Beweisfotos im Anhang' %><%= locals.ccSelf ? ' (du erhältst eine Kopie)' : '' %>.
            </p>
            <p class="small text-danger mb-0">
              ⚠️ Wissentlich falsche Anzeigen sind strafbar (falsche Verdächtigung,
              § 164 StGB). Bitte reiche nur wahrheitsgemäße Angaben ein.
            </p>
          </div>
          <form method="post" action="/anzeige/<%= report.aktenzeichen %>/submit" class="submit-actions"
                data-confirm="Anzeige jetzt zur Prüfung einreichen?&#10;&#10;Mit dem Einreichen bestätigst du die Richtigkeit deiner Angaben – wissentlich falsche Anzeigen sind strafbar (§ 164 StGB).">
            <button type="submit" class="btn btn-success" <%= complete && locals.profileComplete && !locals.verjaehrt ? '' : 'disabled' %>>
              ✓ Einreichen
            </button>
            <% if (isAdmin) { %>
              <button type="submit" class="btn btn-primary ms-1" formaction="/anzeige/<%= report.aktenzeichen %>/submit?sofort=1"
                      title="Prüfung direkt bestätigen und ans Ordnungsamt senden"
                      <%= complete && locals.profileComplete && !locals.verjaehrt ? '' : 'disabled' %>>
                Einreichen &amp; versenden
              </button>
            <% } %>
          </form>
        </div>
      </div>
    <% } else if (!isVersendet) { %>
      <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div>
            <h6 class="mb-1">Wird geprüft</h6>
            <p class="small text-muted mb-0">
              Die Anzeige ist eingereicht. Nach der Freigabe verschicken wir sie ans
              Ordnungsamt<%= locals.ccSelf ? ' – du erhältst die E-Mail in Kopie' : '' %>.
            </p>
          </div>
          <form method="post" action="/anzeige/<%= report.aktenzeichen %>/withdraw" class="submit-actions"
                data-confirm="Anzeige zurückziehen und wieder bearbeiten?">
            <button type="submit" class="btn btn-outline-secondary">Zurückziehen &amp; bearbeiten</button>
          </form>
        </div>
      </div>
    <% } else { %>
      <% if (hasForm && report.pdf_filename) { %>
        <div class="d-flex gap-2 flex-wrap mb-4">
          <a href="/anzeige/<%= report.aktenzeichen %>/pdf" class="btn btn-outline-primary">⬇ PDF herunterladen</a>
        </div>
      <% } %>
    <% } %>

    <!-- Vorschau ganz unten: PDF (Formular-Städte) bzw. E-Mail-Hinweis (rohe E-Mail). -->
    <% if (isPortal) { %>
      <div class="alert alert-info">
        Diese Anzeige wird über das Online-Formular des <strong><%= city.ordnungsamt %></strong>
        übermittelt – ein PDF entsteht dabei nicht. Die Angaben und Beweisfotos werden
        direkt in das Portal der Stadt eingetragen.
      </div>
    <% } else if (hasForm && report.pdf_filename) { %>
      <h4 class="mb-3">PDF-Vorschau</h4>
      <iframe src="/anzeige/<%= report.aktenzeichen %>/pdf?inline=1"
              class="w-100 border rounded" style="height: 600px;"
              title="PDF-Vorschau"></iframe>
    <% } else if (!hasForm) { %>
      <div class="alert alert-info">
        Diese Anzeige wird als E-Mail an das <strong><%= city.ordnungsamt %></strong>
        versendet – für <%= city.name %> gibt es kein amtliches PDF-Formular.
        <% if (city.mail && city.mail.ohneKarte) { %>
          Der E-Mail liegen nur die Beweisfotos (JPG) bei.
        <% } else { %>
          Die Beweisfotos und (soweit vorhanden) eine Tatort-Karte liegen der E-Mail bei.
        <% } %>
        <% if (city.mail && city.mail.hinweise && city.mail.hinweise.length) { %>
          <ul class="mb-0 mt-2 small">
            <% city.mail.hinweise.forEach(function (h) { %><li><%= h %></li><% }) %>
          </ul>
        <% } %>
      </div>
    <% } else { %>
      <p class="text-muted">Die PDF-Vorschau erscheint, sobald der Entwurf gespeichert wurde.</p>
    <% } %>
  </div>
</div>

<!-- Hover-Lupe auf den Beweisfotos (Kennzeichen prüfen ohne Lightbox). -->
<script src="/public/js/image-preview.js"></script>

