<%
const r = locals.report || {}
const images = locals.images || []
const embed = !!locals.embed
const pad = (n) => String(n).padStart(2, '0')
const toDateInput = (d) => {
  if (!d) return ''
  const dt = new Date(d)
  return isNaN(dt) ? '' : `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}`
}
const hhmm = (t) => (t ? String(t).slice(0, 5) : '')
const now = new Date()
const today = toDateInput(now)
const nowTime = `${pad(now.getHours())}:${pad(now.getMinutes())}`
const embedQ = embed ? '&embed=1' : ''
%>
<%#
  Aufbau (oben → unten): Fotos · Angaben (kompakt) · Karte. Läuft auch im
  Editor-Modal der Anzeigen-Liste (embed, s. report-modal.js) – dann ohne
  Navigation; Speichern schließt das Modal.
  Logik: public/js/report-form.js (Fotos, Autosave, Erkennung), report-map.js
  (Karte), verstoss-select.js (Verstoß-Auswahl), address-autocomplete.js.
%>
<div class="editor <%= embed ? 'editor-embed' : '' %>">
  <div class="editor-head">
    <div>
      <h2 class="h4 mb-0">Anzeige bearbeiten</h2>
      <div class="small text-muted">Entwurf <code><%= r.aktenzeichen %></code></div>
    </div>
    <% if (!embed) { %>
      <% if (locals.queue) { %>
        <a href="/import/<%= queue.batchId %>" class="btn btn-outline-secondary btn-sm">← Import-Übersicht</a>
      <% } else { %>
        <a href="/anzeigen" class="btn btn-outline-secondary btn-sm">← Meine Anzeigen</a>
      <% } %>
    <% } %>
  </div>

  <% if (locals.queue) { %>
    <div class="card shadow-sm mb-3 sticky-top editor-queue">
      <div class="card-body py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="fw-semibold">Entwurf <%= queue.position %> von <%= queue.total %></div>
        <div class="d-flex gap-2">
          <% if (queue.prevAz) { %>
            <a class="btn btn-sm btn-outline-secondary" href="/anzeige/<%= queue.prevAz %>/bearbeiten?queue=<%= queue.batchId %><%= embedQ %>">← Zurück</a>
          <% } %>
          <% if (queue.nextAz) { %>
            <a class="btn btn-sm btn-outline-secondary" href="/anzeige/<%= queue.nextAz %>/bearbeiten?queue=<%= queue.batchId %><%= embedQ %>">Überspringen →</a>
          <% } %>
          <button type="submit" form="report-form" class="btn btn-sm btn-primary" data-queue-submit>
            Speichern &amp; weiter<% if (!queue.nextAz) { %> (letzter)<% } %>
          </button>
        </div>
      </div>
    </div>
  <% } %>

  <% if (locals.error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <% if (r.ablehnung_grund) { %>
    <div class="alert alert-warning">
      <strong>Die Prüfung hat die Anzeige zurückgegeben:</strong> <%= r.ablehnung_grund %><br>
      Bitte anpassen und über die Detailseite erneut einreichen.
    </div>
  <% } %>

  <form id="report-form" method="post" action="/anzeige/<%= r.aktenzeichen %>/save"
        data-report-id="<%= r.aktenzeichen %>" <% if (embed) { %>data-embed<% } %>
        <% if (locals.queue) { %>data-queue="<%= queue.batchId %>"<% } %>>
    <% if (locals.queue) { %>
      <input type="hidden" name="queue" value="<%= queue.batchId %>">
    <% } %>
    <% if (embed) { %><input type="hidden" name="embed" value="1"><% } %>

    <!-- ================================================================= -->
    <!-- Fotos                                                               -->
    <!-- ================================================================= -->
    <section class="card shadow-sm editor-section" id="photo-section">
      <div class="editor-section-head">
        <h3 class="h6 mb-0">Beweisfotos <span class="text-muted fw-normal" id="photo-count"></span></h3>
        <label class="btn btn-sm btn-primary mb-0">
          + Fotos hinzufügen
          <input type="file" id="bilder-input" class="visually-hidden"
                 accept="image/png,image/jpeg,image/heic,image/heif,.heic,.heif" multiple>
        </label>
      </div>
      <div class="card-body pt-2">
        <%# Mehrfachauswahl: erscheint, sobald mindestens ein Foto angehakt ist. %>
        <div id="photo-select-bar" class="photo-select-bar" hidden>
          <span class="fw-semibold" id="photo-select-count"></span>
          <button type="button" class="btn btn-sm btn-primary" id="photo-move-new">In neue Anzeige verschieben</button>
          <select class="form-select form-select-sm w-auto" id="photo-move-target" aria-label="In bestehenden Entwurf verschieben">
            <option value="">In Entwurf verschieben …</option>
          </select>
          <button type="button" class="btn btn-sm btn-link" id="photo-select-clear">Auswahl aufheben</button>
        </div>
        <!-- Bereits gespeicherte Bilder; das Script baut daraus die Foto-Karten. -->
        <script id="existing-images-data" type="application/json"><%- JSON.stringify(images.map((img) => ({ id: img.id, url: `/anzeige/${r.aktenzeichen}/image/${img.id}`, v: img.v, capturedAt: img.captured_at || null, detectedPlate: img.detected_plate || null, gpsLat: img.gps_lat !== null ? Number(img.gps_lat) : null, gpsLon: img.gps_lon !== null ? Number(img.gps_lon) : null }))) %></script>
        <div id="image-editor" class="photo-grid"></div>
        <div id="photo-empty" class="photo-empty" hidden>
          Noch keine Fotos. Über „+ Fotos hinzufügen" auswählen oder hierher ziehen.
        </div>
        <div class="form-text mt-2">
          Foto antippen zum Vergrößern · „⬛ Schwärzen" bzw. „✂️ Zuschneiden" öffnen das Foto direkt
          mit dem Werkzeug (Verpixeln/Drehen unter „Mehr …"; alles wird automatisch gespeichert) ·
          Häkchen setzen, um Fotos in eine andere Anzeige zu verschieben.
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- Angaben                                                             -->
    <!-- ================================================================= -->
    <section class="card shadow-sm editor-section">
      <div class="editor-section-head">
        <h3 class="h6 mb-0">Angaben</h3>
        <span class="small text-muted"><span class="text-danger">*</span> für den Versand erforderlich</span>
      </div>
      <div class="card-body pt-2">
        <div class="row g-2 editor-fields">
          <div class="col-12 col-md-5">
            <label class="form-label" for="kennzeichen-input">Kennzeichen <span class="text-danger">*</span></label>
            <%# Freitext: weltweit gibt es kein gemeinsames Format (Ausland, Roller-
                Versicherungskennzeichen, Sonderkennzeichen). Nur Großschreibung. %>
            <input type="text" name="kennzeichen" id="kennzeichen-input" class="form-control plate-field"
                   value="<%= r.kennzeichen || '' %>" maxlength="20"
                   placeholder="z. B. F AB 1234" autocomplete="off" spellcheck="false" autocapitalize="characters">
            <div id="alpr-status" class="form-text" role="status" aria-live="polite"></div>
          </div>
          <div class="col-12 col-md-7">
            <label class="form-label" for="fahrzeug-typ">Fahrzeugtyp</label>
            <%# Liste wie im Frankfurter Portal (config/fahrzeug.ts); leer gespeichert = PKW. %>
            <select name="fahrzeug_typ" id="fahrzeug-typ" class="form-select">
              <% fahrzeugTypen.forEach(function (t) { %>
                <option value="<%= t %>" <%= (r.fahrzeug_typ || defaultFahrzeugTyp) === t ? 'selected' : '' %>><%= t %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-12 col-md-5">
            <label class="form-label" for="fahrzeug-marke">Marke</label>
            <input type="text" name="fahrzeug_marke" id="fahrzeug-marke" class="form-control"
                   value="<%= r.fahrzeug_marke || '' %>" maxlength="100" list="fahrzeug-marken"
                   placeholder="z. B. Volkswagen" autocomplete="off">
            <datalist id="fahrzeug-marken"><% fahrzeugMarken.forEach(function (m) { %><option value="<%= m %>"><% }) %></datalist>
          </div>
          <div class="col-6 col-md-4">
            <label class="form-label" for="fahrzeug-modell">Modell</label>
            <input type="text" name="fahrzeug_modell" id="fahrzeug-modell" class="form-control"
                   value="<%= r.fahrzeug_modell || '' %>" maxlength="60" placeholder="z. B. Golf" autocomplete="off">
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label" for="fahrzeug-farbe">Farbe</label>
            <input type="text" name="fahrzeug_farbe" id="fahrzeug-farbe" class="form-control"
                   value="<%= r.fahrzeug_farbe || '' %>" maxlength="40" list="fahrzeug-farben" autocomplete="off">
            <datalist id="fahrzeug-farben"><% fahrzeugFarben.forEach(function (f) { %><option value="<%= f %>"><% }) %></datalist>
          </div>

          <div class="col-6 col-md-3">
            <label class="form-label" for="tattag">Tattag <span class="text-danger">*</span></label>
            <input type="date" name="tattag" id="tattag" class="form-control"
                   value="<%= toDateInput(r.tattag) || today %>">
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label" for="tatzeit-von">Uhrzeit von <span class="text-danger">*</span></label>
            <input type="time" name="tatzeit_von" id="tatzeit-von" class="form-control"
                   value="<%= hhmm(r.tatzeit_von) || nowTime %>">
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label" for="tattag-bis" title="Nur wenn der Verstoß über Mitternacht andauerte">Tattag bis <span class="text-muted small">(über Nacht)</span></label>
            <input type="date" name="tattag_bis" id="tattag-bis" class="form-control"
                   value="<%= toDateInput(r.tattag_bis) %>">
          </div>
          <%# Verjährung (3 Monate, services/verjaehrung.ts). report-form.js
              (initVerjaehrung) rechnet bei Datumsänderung im Browser nach und
              sperrt dann „Einreichen"; der Server prüft beim Submit erneut. %>
          <% const _vj = verjaehrung({ tattag: r.tattag || today, tattag_bis: r.tattag_bis }) %>
          <div class="col-12" id="verjaehrung-hint" <%= _vj.verjaehrt || _vj.bald ? '' : 'hidden' %>>
            <div class="alert <%= _vj.verjaehrt ? 'alert-danger' : 'alert-warning' %> py-2 px-3 small mb-0" data-verjaehrung-text>
              <% if (_vj.verjaehrt) { %>
                ⌛ Verjährt: Die Tat liegt mehr als drei Monate zurück und kann nicht mehr eingereicht werden.
              <% } else if (_vj.bald) { %>
                ⏳ Verjährt in <%= _vj.restTage %> Tag<%= _vj.restTage === 1 ? '' : 'en' %> – bitte bald einreichen.
              <% } %>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label" for="tatzeit-bis">Uhrzeit bis</label>
            <input type="time" name="tatzeit_bis" id="tatzeit-bis" class="form-control"
                   value="<%= hhmm(r.tatzeit_bis) %>">
          </div>
          <!-- Uhrzeit (von = frühestes, bis = spätestes Foto) aus den EXIF-Daten der
               Fotos übernehmen. Erscheint nur, wenn mindestens ein Foto eine
               Aufnahmezeit enthält (Befüllung in public/js/report-form.js). -->
          <div class="col-12 d-none" id="photo-time-row">
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btn-photo-times">
              🕒 Uhrzeit aus Fotos übernehmen
            </button>
            <span id="photo-time-status" class="form-text ms-2"></span>
          </div>

          <div class="col-12 col-lg-8">
            <label class="form-label" for="tatort">Tatort <span class="text-danger">*</span></label>
            <input type="text" name="tatort" id="tatort" class="form-control"
                   value="<%= r.tatort || '' %>"
                   data-address-autocomplete data-fill="full"
                   data-geo-scope="unlocked"
                   placeholder="Adresse eingeben und aus der Liste wählen …">
            <div class="d-flex align-items-center flex-wrap gap-2 mt-1">
              <button type="button" class="btn btn-link btn-sm p-0" id="btn-current-location">
                📍 Aktueller Standort
              </button>
              <!-- Erscheint nur, wenn mindestens ein Foto GPS-Daten enthält. -->
              <button type="button" class="btn btn-link btn-sm p-0 d-none" id="btn-photo-geo">
                🖼️ Tatort aus Fotos
              </button>
              <span id="geo-status" class="form-text m-0"></span>
            </div>
          </div>
          <div class="col-12 col-lg-4">
            <!-- Zuständiges Ordnungsamt: aus dem Tatort automatisch erkannt
                 (report-form.js: initCity), bei Bedarf manuell umstellbar. -->
            <label for="city-select" class="form-label">Zuständiges Ordnungsamt</label>
            <select name="city" id="city-select" class="form-select">
              <% for (const c of (locals.cities || [])) { %>
                <option value="<%= c.id %>"
                        data-ordnungsamt="<%= c.ordnungsamt %>"
                        data-email="<%= c.email %>"
                        data-center-lat="<%= c.geo.mapLat %>"
                        data-center-lon="<%= c.geo.mapLon %>"
                        <%= report.city === c.id ? 'selected' : '' %>>
                  <%= c.name %>
                </option>
              <% } %>
            </select>
            <div id="city-hint" class="form-text mt-1 mb-0" role="status">
              🏛️ An <strong id="city-ordnungsamt"><%= city.ordnungsamt %></strong>
              (<span id="city-email"><%= locals.cityEmail || '' %></span>)
            </div>
          </div>
          <div class="col-12">
            <div id="city-warning" class="alert alert-warning small mb-0 d-none" role="alert"></div>
          </div>

          <div class="col-12">
            <label class="form-label" for="verstoss-input">Verstoß <span class="text-danger">*</span></label>
            <!-- Durchsuchbare Auswahl (public/js/verstoss-select.js): sichtbares
                 Suchfeld + verstecktes Feld „verstoss_art" (der gespeicherte Wert).
                 Häufige Verstöße stehen oben, darunter der ganze Tatbestandskatalog. -->
            <div data-verstoss-select class="position-relative">
              <input type="hidden" name="verstoss_art" value="<%= r.verstoss_art || '' %>">
              <input type="text" id="verstoss-input" class="form-control" data-verstoss-input
                     autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false"
                     placeholder="Verstoß suchen (z. B. Gehweg, Radweg) oder aus der Liste wählen …"
                     value="<%= r.verstoss_art || '' %>">
              <script type="application/json" data-verstoss-data><%- JSON.stringify({ haeufig: verstossHaeufig, alle: verstossAlle }).replace(/</g, '\\u003c') %></script>
            </div>
            <%# Konkretisierung, wo der Katalog Alternativen offen lässt (Kreuzung/
                Einmündung …) und Hinweis auf „länger als 1 Stunde" – das Frankfurter
                Portal fragt beides ab (services/portalFfm.ts). report-form.js
                (initVariante) blendet beides passend zum gewählten Verstoß ein. %>
            <div class="mt-2" id="verstoss-variante-row" hidden>
              <label class="form-label small mb-1" for="verstoss-variante">Genauer <span class="text-danger">*</span></label>
              <select name="verstoss_variante" id="verstoss-variante" class="form-select form-select-sm" data-current="<%= r.verstoss_variante || '' %>"></select>
            </div>
            <div class="alert alert-info py-1 px-2 small mt-2 mb-0" id="langparker-hint" hidden>
              Die Tatzeit ist länger als eine Stunde.
              <button type="button" class="btn btn-link btn-sm p-0 align-baseline" id="langparker-apply"></button>
            </div>
            <script type="application/json" id="formular-hilfen"><%- JSON.stringify(formularHilfen).replace(/</g, '\\u003c') %></script>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label" for="beschreibung">Beschreibung <span class="text-muted small">(optional)</span></label>
            <textarea name="beschreibung" id="beschreibung" class="form-control" rows="3"
                      placeholder="Optionale Schilderung des Vorfalls"><%= r.beschreibung || '' %></textarea>
          </div>
          <div class="col-12 col-md-6">
            <div class="form-check mt-md-4">
              <input type="checkbox" class="form-check-input" name="fahrzeug_verlassen"
                     id="fahrzeug-verlassen" value="1" <%= r.fahrzeug_verlassen === 1 ? 'checked' : '' %>>
              <label class="form-check-label" for="fahrzeug-verlassen">Das Fahrzeug war verlassen</label>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2 mt-2">
              <span class="small">Wurde jemand behindert?</span>
              <div class="btn-group btn-group-sm" role="group" aria-label="Wurde jemand behindert?">
                <input type="radio" class="btn-check" name="behinderung" id="behinderung-ja"
                       value="ja" <%= r.behinderung === 1 ? 'checked' : '' %>>
                <label class="btn btn-outline-secondary" for="behinderung-ja">Ja</label>
                <!-- Standard: "Nein" – nur explizit gespeichertes "Ja" wählt Ja vor. -->
                <input type="radio" class="btn-check" name="behinderung" id="behinderung-nein"
                       value="nein" <%= r.behinderung !== 1 ? 'checked' : '' %>>
                <label class="btn btn-outline-secondary" for="behinderung-nein">Nein</label>
              </div>
            </div>
          </div>
          <!-- Nur bei „Ja" relevant: wer wurde wie behindert. -->
          <div class="col-12 <%= r.behinderung === 1 ? '' : 'd-none' %>" id="behinderung-detail">
            <label class="form-label" for="behinderung-text">Wer wurde wie behindert?</label>
            <textarea name="behinderung_text" id="behinderung-text" class="form-control" rows="2"
                      placeholder="z. B. Rollstuhlfahrer musste auf die Straße ausweichen"><%= r.behinderung_text || '' %></textarea>
            <!-- Schnellauswahl: Klick übernimmt den Satz ins Textfeld. -->
            <div class="d-flex flex-wrap gap-1 mt-2">
              <% for (const satz of [
                'Ich musste auf die Straße ausweichen.',
                'Ich musste auf den Gehweg ausweichen.',
                'Ich musste auf den Radweg ausweichen.',
                'Ich musste mit dem Rad auf die Fahrbahn ausweichen.',
                'Fußgänger mussten auf die Straße ausweichen.',
                'Rollstuhlfahrer bzw. Kinderwagen kamen nicht vorbei.',
              ]) { %>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-behinderung-vorschlag="<%= satz %>"><%= satz %></button>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================================================================= -->
    <!-- Karte                                                               -->
    <!-- ================================================================= -->
    <section class="card shadow-sm editor-section">
      <div class="editor-section-head">
        <h3 class="h6 mb-0">Tatort auf der Karte</h3>
        <span class="small text-muted d-none d-sm-inline">Marker zur genauen Stelle ziehen – die Adresse wird übernommen.</span>
      </div>
      <div class="card-body pt-2">
        <!-- Marker lässt sich verschieben; die Adresse wird dann per Reverse-
             Geocoding aktualisiert. Koordinaten gehen in die Hidden-Felder. -->
        <div id="tatort-map" class="rounded border map-panel"
             data-lat="<%= r.tatort_lat || '' %>" data-lon="<%= r.tatort_lon || '' %>"
             data-thumb="<%= (typeof firstImageUrl !== 'undefined' && firstImageUrl) ? firstImageUrl : '' %>"
             data-center-lat="<%= city.geo.mapLat %>" data-center-lon="<%= city.geo.mapLon %>"></div>
        <div class="form-text">Ein Ausschnitt der Karte wird automatisch als Vorschaubild in die Anzeige übernommen.</div>
        <input type="hidden" name="tatort_lat" value="<%= r.tatort_lat || '' %>">
        <input type="hidden" name="tatort_lon" value="<%= r.tatort_lon || '' %>">
      </div>
    </section>

    <%# Aktionsleiste klebt am unteren Rand – Speichern ist immer erreichbar. %>
    <div class="editor-actions">
      <span id="save-status" class="small text-muted me-auto" role="status" aria-live="polite"></span>
      <div id="submit-error" class="alert alert-danger py-2 px-3 small mb-0 w-100" role="alert" hidden></div>
      <%# Verwerfen führt erst auf eine Bestätigungsseite (serverseitig erzwungen);
          im Modal fragt report-form.js direkt nach. %>
      <button type="submit" form="discard-form" class="btn btn-outline-danger" id="btn-discard">🗑 In den Papierkorb</button>
      <button type="submit" class="btn btn-outline-primary" id="btn-save">
        <%= embed ? 'Speichern & schließen' : 'Entwurf speichern' %>
      </button>
      <%# Speichert und reicht direkt zur Prüfung ein (report-form.js: initSubmit).
          Ziel danach: nächster Entwurf der Import-Queue, sonst Detailseite bzw.
          im Modal zurück zur Liste. %>
      <button type="button" class="btn btn-success" id="btn-submit" <%= _vj.verjaehrt ? 'disabled' : '' %>
              data-after="<%= locals.queue ? (queue.nextAz ? `/anzeige/${queue.nextAz}/bearbeiten?queue=${queue.batchId}${embedQ}` : `/import/${queue.batchId}`) : `/anzeige/${r.aktenzeichen}` %>">
        Speichern &amp; Einreichen
      </button>
    </div>
  </form>

  <% if (!embed) { %>
    <p class="text-muted small mt-3">
      Als Entwurf kannst du jederzeit speichern – auch mit nur einem ausgefüllten Feld oder
      nur einem Foto. Eingaben werden zudem automatisch gespeichert. Deine persönlichen Daten
      (Name, Adresse) werden aus den <a href="/einstellungen">Einstellungen</a> übernommen.
    </p>
  <% } %>
</div>

<form id="discard-form" method="post" action="/anzeige/<%= r.aktenzeichen %>/discard" class="d-none"></form>

<!-- Leaflet für die Tatort-Karte (Tiles kommen same-origin über /tiles/...). -->
<link rel="stylesheet" href="/public/vendor/leaflet.css">

<script>
  // Ziel-Entwürfe für „Fotos verschieben"; "<" wird escaped, damit Nutzereingaben
  // (z.B. Tatort) das Script-Tag nicht vorzeitig beenden können.
  window.OTHER_DRAFTS = <%- JSON.stringify((locals.otherDrafts || []).map((d) => ({
    az: d.aktenzeichen,
    label: [d.aktenzeichen, d.kennzeichen, d.tattag_fmt, d.tatort && d.tatort.slice(0, 40)].filter(Boolean).join(' · '),
  }))).replace(/</g, '\\u003c') %>;
</script>
<!-- Optionale Hilfe: EXIF-GPS aus Fotos lesen. heic2any lädt report-form.js bei Bedarf nach. -->
<script src="/public/vendor/exifr-lite.umd.js"></script>
<script src="/public/vendor/leaflet.js"></script>
<script src="/public/js/report-form.js"></script>
<script src="/public/js/report-map.js"></script>
<script src="/public/js/verstoss-select.js"></script>
<script src="/public/js/image-preview.js"></script>
