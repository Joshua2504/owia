<%
// Prüf-Modus (routes/review.ts, public/js/review.js): offene Entwürfe einzeln
// nacheinander prüfen und einreichen. Die Karte wird komplett von review.js
// gebaut; hier nur Gerüst, Reihenfolge und Verstoß-Katalog.
%>
<div class="review-top">
  <div class="d-flex align-items-center gap-2 flex-wrap">
    <h2 class="h4 mb-0 me-auto">Prüf-Modus</h2>
    <% if (!nurAz) { %>
    <div class="status-chips" role="group" aria-label="Welche Entwürfe">
      <a class="btn btn-sm <%= nurBereit ? 'btn-outline-secondary' : 'btn-secondary' %>" href="/pruefen">Alle Entwürfe (<%= countAlle %>)</a>
      <a class="btn btn-sm <%= nurBereit ? 'btn-secondary' : 'btn-outline-secondary' %>" href="/pruefen?nur=bereit">Nur „Bereit" (<%= countBereit %>)</a>
    </div>
    <% } %>
    <a class="btn btn-sm btn-outline-secondary" href="<%= zurueck %>"><%= zurueck === '/kamera' ? '📷 Zur Kamera' : 'Beenden' %></a>
  </div>
  <div class="review-progress mt-2" aria-hidden="true"><div class="review-progress-bar"></div></div>
  <div class="d-flex flex-wrap gap-3 small text-muted mt-1">
    <span id="review-pos" role="status"></span>
    <span id="review-stats"></span>
    <label class="d-flex align-items-center gap-1 ms-auto">
      <input type="checkbox" class="form-check-input mt-0" id="review-autophoto"> Foto-Ansicht automatisch
    </label>
  </div>
  <% if (countVerjaehrt) { %>
    <div class="small text-muted mt-1"><%= countVerjaehrt %> verjährte(r) Entwurf/Entwürfe ausgeblendet – die lassen sich nicht mehr einreichen.</div>
  <% } %>
</div>

<div id="review-root" class="review-root">
  <% if (!queue.length) { %>
    <div class="card shadow-sm"><div class="card-body text-center py-5 text-muted">
      <p class="mb-3"><%= nurAz ? 'Dieser Entwurf ist nicht mehr offen.' : nurBereit ? 'Keine Entwürfe mit „Bereit"-Markierung.' : 'Keine offenen Entwürfe – alles erledigt. 🎉' %></p>
      <% if (zurueck === '/kamera') { %><a class="btn btn-primary me-2" href="/kamera">📷 Nächster Verstoß</a><% } %>
      <a class="btn btn-outline-primary" href="/anzeigen">Zu meinen Anzeigen</a>
    </div></div>
  <% } else { %>
    <div class="card shadow-sm"><div class="card-body text-muted">Wird geladen …</div></div>
  <% } %>
</div>

<script type="application/json" id="review-data"><%- JSON.stringify({ queue, verstoss, cities, zurueck }).replace(/</g, '\\u003c') %></script>
<link rel="stylesheet" href="/public/vendor/leaflet.css">
<script src="/public/vendor/leaflet.js"></script>
<script src="/public/js/verstoss-select.js" defer></script>
<script src="/public/js/photo-edit.js" defer></script>
<script src="/public/js/report-modal.js" defer></script>
<script src="/public/js/report-submit.js" defer></script>
<script src="/public/js/review.js" defer></script>
