<%
// Admin-Benutzerübersicht (GET /admin/benutzer): alle Konten mit
// Anzeigen-Kennzahlen, read-only. Anonymisierte Konten (Selbst-Löschung,
// routes/settings.ts) sind an Platzhalter-Mail + Badge erkennbar.
const active = users.filter((u) => !u.anonymized_at)
%>

<div class="page-head">
  <h2>Benutzer</h2>
  <div class="text-muted small">
    <%= active.length %> aktiv<% if (users.length - active.length) { %>, <%= users.length - active.length %> geschlossen<% } %>
  </div>
</div>

<div class="card shadow-sm">
  <div class="table-responsive">
    <%# table-stack (app.css): auf dem Handy je Konto eine Karte, Spaltenname aus data-label. %>
    <table class="table table-sm table-hover align-middle mb-0 table-stack">
      <thead class="table-light">
        <tr>
          <th>E-Mail</th>
          <th>Name</th>
          <th>Ort</th>
          <th>Registriert</th>
          <th class="text-end">Entwürfe</th>
          <th class="text-end">Eingereicht</th>
          <th class="text-end">Versendet</th>
          <th class="text-end">Fotos</th>
          <th>Letzte Anzeige</th>
        </tr>
      </thead>
      <tbody>
        <% for (const u of users) { %>
          <tr class="<%= u.anonymized_at ? 'text-muted' : '' %>">
            <td data-label="E-Mail">
              <% if (u.anonymized_at) { %>
                <span class="badge text-bg-secondary">Konto geschlossen</span>
                <div class="small text-muted"><a href="/admin/benutzer/<%= u.id %>" class="text-muted"><%= u.email %></a></div>
              <% } else { %>
                <a href="/admin/benutzer/<%= u.id %>" class="text-decoration-none"><%= u.email %></a>
              <% } %>
            </td>
            <td data-label="Name"><%= [u.vorname, u.nachname].filter(Boolean).join(' ') || '—' %></td>
            <td data-label="Ort"><%= [u.plz, u.ort].filter(Boolean).join(' ') || '—' %></td>
            <td class="text-nowrap" data-label="Registriert"><%= u.created_fmt || '—' %></td>
            <td class="text-end" data-label="Entwürfe"><%= Number(u.drafts) || 0 %></td>
            <td class="text-end" data-label="Eingereicht"><%= Number(u.submitted) || 0 %></td>
            <td class="text-end" data-label="Versendet"><%= Number(u.sent) || 0 %></td>
            <td class="text-end" data-label="Fotos"><%= imagesByUser[u.id] || 0 %></td>
            <td class="text-nowrap" data-label="Letzte Anzeige"><%= u.last_report_fmt || '—' %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
