<%#
  Live-Versand über das Online-Portal (Frankfurt/ekom21). Links die eingereichten
  Anzeigen, rechts der Browser des Portal-Dienstes live. Logik im Browser:
  public/js/portal-live.js, Server: routes/portal.ts + services/portalDispatch.ts.
%>
<div class="d-flex flex-wrap align-items-baseline gap-2 mb-3">
  <h2 class="h4 mb-0">Live-Versand</h2>
  <span class="text-muted small">Online-Formulare der Städte: <%= staedte %></span>
  <span class="ms-auto d-flex align-items-center gap-2 small">
    <form class="d-flex align-items-center gap-1" data-abstand
          title="Mindestabstand zwischen zwei Portal-Anzeigen (Warteschlange und „nacheinander senden“). Mail-Versand ist nicht getaktet.">
      <label for="versand-abstand" class="text-muted text-nowrap">Abstand</label>
      <input id="versand-abstand" type="number" min="0" max="1440" step="0.5" class="form-control form-control-sm" style="width:5.5rem"
             value="<%= Math.round(abstandSek / 30) / 2 %>" required>
      <span class="text-muted">min</span>
      <button type="submit" class="btn btn-sm btn-outline-primary">Speichern</button>
    </form>
    <% if (selbsttest) { %>
      <span class="badge <%= selbsttest.laeuft ? 'text-bg-info' : selbsttest.ok ? 'text-bg-success' : 'text-bg-danger' %>"
            title="<%= selbsttest.meldung %>">Selbsttest <%= selbsttest.laeuft ? '' : selbsttest.ok ? 'OK' : 'FEHLER' %> · <%= selbsttest.zeit %></span>
    <% } %>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-act="selbsttest"
            title="Trockenlauf mit Testdaten bis zur Zusammenfassung – es wird nichts abgesendet">Selbsttest starten</button>
  </span>
</div>

<% if (!portalOk) { %>
  <div class="alert alert-danger">
    Der Portal-Dienst ist nicht erreichbar. Läuft der Container <code>portal</code>?
    (<code>docker compose up -d portal</code>)
  </div>
<% } %>

<div class="row g-3 versand" data-versand data-selected-az="<%= selectedAz %>">
  <div class="col-lg-4 order-2 order-lg-1">
    <div class="card shadow-sm">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span>Zu versenden <span class="badge text-bg-secondary" data-count><%= queue.offen.length %></span></span>
      </div>
      <div class="card-body py-2 small border-bottom">
        <label class="form-check mb-1">
          <input type="checkbox" class="form-check-input" data-opt="auto">
          <span class="form-check-label">Ohne Rückfrage absenden – nur wenn der Lauf ganz ohne Eingriff durchkam</span>
        </label>
        <label class="form-check mb-2">
          <input type="checkbox" class="form-check-input" data-opt="next">
          <span class="form-check-label">Danach automatisch mit der nächsten Anzeige weitermachen</span>
        </label>
        <button type="button" class="btn btn-sm btn-outline-primary w-100" data-act="alle">▶▶ Alle nacheinander senden</button>
      </div>
      <ul class="list-group list-group-flush versand-list" data-list>
        <% if (!queue.offen.length) { %>
          <li class="list-group-item text-muted small" data-empty>Keine eingereichten Anzeigen für das Portal.</li>
        <% } %>
        <%# Wartender Auto-Start: Countdown bis zum geplanten Job-Start (Versand-Takt
            bzw. nach Mitternacht), zählt in portal-live.js herunter. %>
        <% function uhr(sek) { const h = Math.floor(sek / 3600), m = Math.floor(sek % 3600 / 60), s = sek % 60, p = (n) => String(n).padStart(2, '0'); return (h ? h + ':' + p(m) : p(m)) + ':' + p(s) } %>
        <% function autoBadge(sek, fallback) {
             if (!sek) return '<span class="badge text-bg-info" title="Nach der Freigabe eingereiht – startet automatisch, sobald ein Platz frei ist.">' + fallback + '</span>'
             return '<span class="badge text-bg-info" data-auto-in="' + sek + '" title="Geplanter Start (Versand-Takt bzw. nach Mitternacht).">⏱ automatischer Versand in <span data-auto-uhr>' + uhr(sek) + '</span></span>'
           } %>
        <% queue.offen.forEach(function (r) { %>
          <li class="list-group-item versand-item" data-id="<%= r.id %>" data-az="<%= r.az %>" data-sendbar="<%= r.imPortal && !r.abMorgen ? '1' : '' %>"
              data-unklar="<%= r.unklar ? '1' : '' %>" data-busy="<%= (r.versandStatus || (r.autoStart && !r.abMorgen)) && !r.unklar ? '1' : '' %>">
            <div class="d-flex justify-content-between gap-2">
              <a href="/anzeige/<%= r.az %>" class="fw-semibold" target="_blank" rel="noopener"><%= r.az %></a>
              <span class="d-flex gap-1 align-items-center">
                <span class="badge text-bg-light border"><%= r.stadt %></span>
                <span class="plate-chip"><%= r.kennzeichen || '—' %></span>
              </span>
            </div>
            <div class="small text-muted"><%= r.tatzeit %> · <%= r.bilder %> Foto<%= r.bilder === 1 ? '' : 's' %><%= r.fahrzeug ? ' · ' + r.fahrzeug : '' %></div>
            <div class="small text-truncate" title="<%= r.tatort %>"><%= r.tatort %></div>
            <div class="small text-truncate" title="<%= r.verstoss %>"><%= r.verstoss %><%= r.variante ? ' (' + r.variante + ')' : '' %></div>
            <div class="mt-1 d-flex flex-wrap gap-1 align-items-center">
              <% if (r.unklar) { %>
                <span class="badge text-bg-danger" title="<%= r.unklarGrund || '' %>">Ergebnis unklar</span>
                <button type="button" class="btn btn-sm btn-outline-success" data-act="klaeren-ja">Wurde versendet</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-act="klaeren-nein">Nicht angekommen</button>
              <% } else { %>
                <% if (!r.imPortal) { %>
                  <span class="badge text-bg-danger">Tatbestand nicht im Portal – nicht versendbar</span>
                  <a class="btn btn-sm btn-outline-secondary ms-auto" href="/anzeige/<%= r.az %>">Ansehen</a>
                <% } else if (r.abMorgen) { %>
                  <span class="badge text-bg-secondary" title="Das Portal nimmt nur Taten vor dem heutigen Tag an.">Tat von heute – ab morgen versendbar</span>
                  <% if (r.autoStart) { %><%- autoBadge(r.autoIn, 'startet automatisch nach Mitternacht') %><% } %>
                <% } else { %>
                  <% if (r.varianteFehlt) { %><span class="badge text-bg-warning" title="Die Konkretisierung (z. B. Kreuzung/Einmündung) fehlt – sie wird live abgefragt.">Variante fehlt</span><% } %>
                  <% if (r.versandStatus) { %><span class="badge text-bg-info">läuft</span><% } else if (r.autoStart) { %><%- autoBadge(r.autoIn, 'startet automatisch') %><% } %>
                  <button type="button" class="btn btn-sm btn-primary ms-auto" data-act="start">▶ Senden</button>
                <% } %>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    </div>

    <% if (queue.gesendet.length) { %>
      <div class="card shadow-sm mt-3" data-gesendet>
        <div class="card-header">Zuletzt über das Portal versendet</div>
        <ul class="list-group list-group-flush small">
          <% queue.gesendet.forEach(function (r) { %>
            <li class="list-group-item d-flex justify-content-between gap-2">
              <a href="/anzeige/<%= r.aktenzeichen %>"><%= r.aktenzeichen %></a>
              <span class="text-muted"><%= r.kennzeichen %></span>
              <span class="font-monospace"><%= r.portal_vorgang_id || '—' %></span>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </div>

  <div class="col-lg-8 order-1 order-lg-2">
    <%# Ein Fenster = ein Lauf; der Portal-Dienst nimmt nur einen gleichzeitig an (MAX_ACTIVE 1). %>
    <div class="card shadow-sm versand-live mb-3" data-slot>
      <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <span class="badge text-bg-light border" data-slot-nr></span>
        <strong data-live-az>frei</strong>
        <span class="badge text-bg-secondary" data-live-state>bereit</span>
        <span class="small text-muted" data-live-step></span>
      </div>
      <div class="card-body p-2">
        <div class="alert py-2 px-3 small mb-2" data-live-msg hidden></div>
        <div class="versand-screen" data-screen tabindex="0"
             title="Live-Bild des Portal-Browsers. Klicken, scrollen und tippen wirkt direkt im Formular.">
          <video data-video muted playsinline disablepictureinpicture disableremoteplayback hidden></video>
          <img alt="Live-Bild des Portal-Browsers" data-frame hidden>
          <div class="versand-screen-empty text-muted small" data-frame-empty>
            Links eine Anzeige mit „▶ Senden" starten – hier erscheint dann der Browser live.
          </div>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
          <button type="button" class="btn btn-success" data-act="absenden" disabled>✓ Jetzt absenden</button>
          <button type="button" class="btn btn-warning" data-act="fortsetzen" hidden>Fortsetzen</button>
          <button type="button" class="btn btn-outline-danger" data-act="abbrechen" disabled>Abbrechen</button>
          <div class="input-group input-group-sm ms-auto versand-type">
            <input type="text" class="form-control" placeholder="Text ins Formular tippen …" data-type-text aria-label="Text tippen">
            <button type="button" class="btn btn-outline-secondary" data-act="type">Tippen</button>
            <button type="button" class="btn btn-outline-secondary" data-key="Tab">⇥</button>
            <button type="button" class="btn btn-outline-secondary" data-key="Enter">⏎</button>
          </div>
        </div>
        <details class="mt-2 small">
          <summary>Protokoll</summary>
          <ol class="versand-log mb-0" data-log></ol>
        </details>
      </div>
    </div>
  </div>
</div>

<script src="/public/js/portal-live.js"></script>
