<%
const hhmm = (t) => (t ? String(t).slice(0, 5) : '')
const fmtDate = (d) => (d ? new Date(d).toLocaleDateString('de-DE') : '—')
%>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2 class="mb-0">Prüfung eingereichter Anzeigen</h2>
</div>

<% if (!pending.length) { %>
  <div class="card shadow-sm mb-4">
    <div class="card-body text-center py-5 text-muted">
      Keine Anzeigen zur Prüfung offen. 🎉
    </div>
  </div>
<% } %>

<% for (const r of pending) { %>
  <%# id = Sprungziel der Admin-Benachrichtigungsmail (#a-<id>) %>
  <div class="card shadow-sm mb-4" id="a-<%= r.id %>" style="scroll-margin-top:1rem">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <code><%= r.aktenzeichen %></code>
        <span class="text-muted small ms-2">von <%= r.user_email %> · eingereicht <%= r.eingereicht_fmt %></span>
      </div>
      <span class="plate-chip"><% if (r.kennzeichen_land && r.kennzeichen_land !== 'D') { %><small><%= r.kennzeichen_land %></small><% } %><%= r.kennzeichen %></span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-lg-5">
          <dl class="row small mb-3">
            <dt class="col-sm-4">Tattag / Zeit</dt>
            <dd class="col-sm-8">
              <%= fmtDate(r.tattag) %><% if (r.tattag_bis && fmtDate(r.tattag_bis) !== fmtDate(r.tattag)) { %> – <%= fmtDate(r.tattag_bis) %><% } %>
              <% const von = hhmm(r.tatzeit_von), bis = hhmm(r.tatzeit_bis) %>
              <% if (von) { %>, <%= von %><% if (bis && bis !== von) { %> – <%= bis %><% } %> Uhr<% } %>
              <% if (verjaehrung(r).verjaehrt) { %><span class="badge text-bg-danger ms-1">⌛ Verjährt</span><% } %>
            </dd>
            <dt class="col-sm-4">Tatort</dt>
            <dd class="col-sm-8"><%= r.tatort %></dd>
            <dt class="col-sm-4">Verstoß</dt>
            <dd class="col-sm-8">
              <%= r.verstoss_art %>
              <% if (r.fahrzeug_verlassen === 1) { %><br><span class="text-muted">Fahrzeug war verlassen</span><% } %>
            </dd>
            <% if (r.beschreibung) { %>
              <dt class="col-sm-4">Beschreibung</dt>
              <dd class="col-sm-8"><%= r.beschreibung %></dd>
            <% } %>
            <dt class="col-sm-4">Behinderung</dt>
            <dd class="col-sm-8">
              <%= r.behinderung === 1 ? 'Ja' : 'Nein' %>
              <% if (r.behinderung === 1 && r.behinderung_text) { %> – <%= r.behinderung_text %><% } %>
            </dd>
            <dt class="col-sm-4">Fotos</dt>
            <dd class="col-sm-8"><%= r.image_count %></dd>
            <dt class="col-sm-4">Anzeigenerstatter</dt>
            <dd class="col-sm-8">
              <% const profil = [[r.vorname, r.nachname].filter(Boolean).join(' '), [r.strasse, r.hausnummer].filter(Boolean).join(' '), [r.plz, r.ort].filter(Boolean).join(' ')].filter(Boolean).join(', ') %>
              <% if (profil && r.vorname && r.nachname && r.strasse && r.hausnummer && r.plz && r.ort) { %>
                <%= profil %>
              <% } else { %>
                <span class="text-danger">⚠️ Profil unvollständig<%= profil ? ': ' + profil : '' %></span>
              <% } %>
            </dd>
          </dl>

          <% const vj = typeof versandJobs !== 'undefined' ? versandJobs[r.id] : undefined %>
          <% if (vj && (vj.status === 'queued' || vj.status === 'running')) { %>
            <div class="alert alert-info small">⏳ Versand läuft im Hintergrund – Seite später neu laden.</div>
          <% } else if (vj && vj.status === 'failed' && !r.versand_status) { %>
            <div class="alert alert-danger small">Letzter Versandversuch fehlgeschlagen: <%= vj.error %></div>
          <% } %>
          <% if (r.versand_status) { %>
            <div class="alert alert-warning small">
              <% if (r.versand_status === 'angenommen') { %>
                Der Mailserver hat die Anzeige angenommen. Der lokale Abschluss steht noch aus.
              <% } else { %>
                Die Anzeige wird verarbeitet. Bleibt dieser Hinweis bestehen, muss der Versand geprüft werden,
                bevor erneut verschickt oder abgelehnt werden kann.
              <% } %>
            </div>
          <% } %>
          <% if ((!r.versand_status || r.versand_status === 'angenommen') && !(vj && (vj.status === 'queued' || vj.status === 'running'))) { %>
            <form method="post" action="/admin/anzeigen/<%= r.id %>/approve"
                  onsubmit="return confirm('<%= r.versand_status === 'angenommen' ? 'Versandabschluss ohne erneute Mail speichern?' : 'Anzeige freigeben und ans Ordnungsamt verschicken?' %>')">
              <button type="submit" class="btn btn-success"><%= r.versand_status === 'angenommen' ? 'Abschluss speichern (ohne erneuten Versand)' : '✓ Freigeben & verschicken' %></button>
            </form>
          <% } %>
          <% if (!r.versand_status) { %>
            <button type="button" class="btn btn-outline-danger mt-2" data-bs-toggle="collapse"
                    data-bs-target="#reject-<%= r.id %>">✕ Ablehnen</button>
            <div class="collapse mt-2" id="reject-<%= r.id %>">
              <form method="post" action="/admin/anzeigen/<%= r.id %>/reject">
                <textarea name="grund" class="form-control form-control-sm mb-2" rows="2" required
                          placeholder="Begründung für den Nutzer"></textarea>
                <button type="submit" class="btn btn-sm btn-danger">Ablehnen &amp; Nutzer informieren</button>
              </form>
            </div>
          <% } %>
        </div>
        <div class="col-lg-7">
          <!-- Das PDF enthält alle Angaben, Kartenseite und Beweisfotos. -->
          <iframe src="/admin/anzeigen/<%= r.id %>/pdf" class="w-100 border rounded"
                  style="height:420px" title="PDF <%= r.aktenzeichen %>" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% const unmatched = locals.unmatched || [] %>
<% if (unmatched.length) { %>
  <div class="card shadow-sm mb-4 border-warning" id="antworten" style="scroll-margin-top:1rem">
    <div class="card-body">
      <h5 class="card-title mb-1">Nicht zugeordnete Antworten (<%= unmatched.length %>)</h5>
      <p class="text-muted small mb-3">
        Eingegangene Mails ohne erkennbares Aktenzeichen. Spam markieren und gesammelt verwerfen,
        echte Antworten aufklappen und per Aktenzeichen zuordnen.
      </p>
      <form method="post" action="/admin/replies/bulk-discard" id="reply-bulk-form">
        <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
          <input type="search" class="form-control form-control-sm w-auto" id="reply-filter" placeholder="Filtern (Absender/Betreff)…">
          <button type="button" class="btn btn-sm btn-outline-secondary" id="reply-select-visible">Sichtbare markieren</button>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="reply-select-none">Keine</button>
          <button type="submit" class="btn btn-sm btn-danger ms-auto" id="reply-bulk-btn" disabled>🗑 Markierte verwerfen (<span id="reply-count">0</span>)</button>
        </div>
      </form>
      <div class="table-responsive" style="max-height:70vh; overflow-y:auto">
        <table class="table table-sm table-hover align-middle mb-0 small">
          <thead class="sticky-top bg-body">
            <tr>
              <th style="width:2rem"><input type="checkbox" class="form-check-input" id="reply-all" title="Alle sichtbaren"></th>
              <th>Eingang</th><th>Absender</th><th>Betreff</th><th class="text-end">📎</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% for (const m of unmatched) { %>
              <tr class="reply-row" data-search="<%= ((m.from_address || '') + ' ' + (m.subject || '')).toLowerCase() %>">
                <td><input type="checkbox" class="form-check-input reply-check" name="ids" value="<%= m.id %>" form="reply-bulk-form"></td>
                <td class="text-nowrap text-muted"><%= m.received_at ? new Date(m.received_at).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' }) : '' %></td>
                <td class="text-truncate" style="max-width:16rem"><%= m.from_address || 'Unbekannt' %></td>
                <td class="text-truncate" style="max-width:28rem"><%= m.subject || '(kein Betreff)' %></td>
                <td class="text-end text-muted"><%= m.attachment_count || '' %></td>
                <td class="text-end"><button type="button" class="btn btn-sm btn-link p-0" data-bs-toggle="collapse" data-bs-target="#reply-<%= m.id %>">Details</button></td>
              </tr>
              <tr class="collapse" id="reply-<%= m.id %>">
                <td colspan="6" class="bg-body-tertiary">
                  <div style="white-space:pre-wrap; max-height:18rem; overflow-y:auto"><%= m.body_text || '' %></div>
                  <div class="d-flex gap-2 mt-2 flex-wrap">
                    <form method="post" action="/admin/replies/<%= m.id %>/assign" class="d-flex gap-2">
                      <input type="text" name="aktenzeichen" class="form-control form-control-sm w-auto" placeholder="OWiA-123456" required>
                      <button type="submit" class="btn btn-sm btn-outline-primary">Zuordnen</button>
                    </form>
                    <form method="post" action="/admin/replies/<%= m.id %>/discard" class="ms-auto"
                          onsubmit="return confirm('Antwort endgültig verwerfen? Text und Anhänge werden gelöscht.')">
                      <button type="submit" class="btn btn-sm btn-outline-danger">🗑 Verwerfen</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <script>
    (() => {
      const checks = () => [...document.querySelectorAll('.reply-check')]
      const visible = () => checks().filter((c) => !c.closest('tr').hidden)
      const update = () => {
        const n = checks().filter((c) => c.checked).length
        document.getElementById('reply-count').textContent = n
        document.getElementById('reply-bulk-btn').disabled = n === 0
      }
      document.getElementById('reply-bulk-form').addEventListener('submit', (e) => {
        const n = checks().filter((c) => c.checked).length
        if (!n || !confirm(n + ' Antwort(en) endgültig verwerfen? Text und Anhänge werden gelöscht.')) e.preventDefault()
      })
      document.addEventListener('change', (e) => { if (e.target.classList.contains('reply-check')) update() })
      document.getElementById('reply-all').addEventListener('change', (e) => { visible().forEach((c) => (c.checked = e.target.checked)); update() })
      document.getElementById('reply-select-visible').addEventListener('click', () => { visible().forEach((c) => (c.checked = true)); update() })
      document.getElementById('reply-select-none').addEventListener('click', () => { checks().forEach((c) => (c.checked = false)); document.getElementById('reply-all').checked = false; update() })
      document.getElementById('reply-filter').addEventListener('input', (e) => {
        const q = e.target.value.trim().toLowerCase()
        document.querySelectorAll('.reply-row').forEach((tr) => {
          tr.hidden = q && !tr.dataset.search.includes(q)
          if (tr.hidden) tr.nextElementSibling.classList.remove('show')
        })
      })
    })()
  </script>
<% } %>

<% if (recent.length) { %>
  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title mb-3">Zuletzt verschickt</h5>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <tbody>
            <% for (const r of recent) { %>
              <tr>
                <td><code class="small"><%= r.aktenzeichen %></code></td>
                <td><code><%= r.kennzeichen %></code></td>
                <td class="small text-muted"><%= r.tatort %></td>
                <td class="small text-muted"><%= r.user_email %></td>
                <td class="text-end">
                  <a class="btn btn-sm btn-outline-secondary" href="/admin/anzeigen/<%= r.id %>/pdf" target="_blank">PDF</a>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>
