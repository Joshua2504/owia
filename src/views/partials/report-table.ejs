<%
// Gemeinsame Anzeigen-Tabelle für Dashboard und Foto-Import-Übersicht.
// Alle Details stehen in der Tabelle (Zeile: report-row.ejs); bearbeitet wird
// einzeln auf der Anzeigen-Seite oder gemeinsam über report-bulk.js.
// Erwartet: reports (Felder s. report-row.ejs inkl. status), imagesByReport
// ({ reportId: [imageIds] }), optional queueId (Edit-Links öffnen die
// Review-Queue des Batches).
// Thumbnails: Klick = Lightbox, Ziehen = in anderen Entwurf verschieben
// (public/js/report-table.js muss auf der Seite eingebunden sein).
const _queueId = typeof queueId !== 'undefined' && queueId ? queueId : null
const _hasDrafts = reports.some((r) => r.status === 'entwurf')
%>
<%# Ab md eine Tabelle, darunter Karten (Regeln in app.css, Zellklassen in
    report-row.ejs) – der Großteil der Nutzer kommt per Handy und soll nicht
    seitwärts scrollen müssen. Das Markup bleibt bewusst eine Tabelle, weil
    report-table.js an <tr data-drop-az> hängt. %>
<div class="report-filters p-3 d-flex flex-wrap gap-2">
  <label class="flex-grow-1">Suchen<input type="search" id="report-search" class="form-control" placeholder="Kennzeichen, Aktenzeichen, Tatort"></label>
  <label>Status<select id="report-status" class="form-select"><option value="">Alle</option><option value="entwurf">Entwürfe</option><option value="eingereicht">Eingereicht</option><option value="versendet">Versendet</option></select></label>
  <% if (_hasDrafts) { %><label class="d-flex align-items-center gap-2 report-select-label"><input type="checkbox" id="bulk-select-all" class="form-check-input"> Sichtbare Entwürfe auswählen</label><% } %>
  <span id="report-visible-count" class="small text-muted w-100" role="status"></span>
</div>
<div class="table-responsive report-table-wrap">
  <table class="table table-sm table-hover align-middle mb-0 report-table">
    <thead class="table-light">
      <tr>
        <th style="width:2rem"><span class="visually-hidden">Auswahl</span></th>
        <th>Fotos</th>
        <th>Aktenzeichen</th>
        <th>Kennzeichen</th>
        <th>Tattag / Zeit</th>
        <th>Tatort</th>
        <th>Verstoß</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% for (const r of reports) { %>
        <%- include('report-row', {
          r,
          imgIds: (typeof imagesByReport !== 'undefined' && imagesByReport && imagesByReport[r.id]) || [],
          queueId: _queueId,
        }) %>
      <% } %>
    </tbody>
  </table>
</div>
<% if (_hasDrafts) { %>
  <!-- Sammel-Löschen der angehakten Entwürfe. Die Checkboxen in den Zeilen
       hängen per form-Attribut an diesem Formular (Zeilen enthalten bereits
       eigene Einzel-Löschen-Formulare, Verschachtelung ist nicht erlaubt).
       Der POST führt erst auf eine Bestätigungsseite (serverseitig erzwungen). -->
  <form id="bulk-discard-form" method="post" action="/anzeigen/loeschen"
        class="d-none align-items-center flex-wrap gap-2 bulk-action-bar">
    <span id="bulk-count" class="small text-muted" role="status"></span>
    <button type="button" id="bulk-edit" class="btn btn-primary">Gemeinsam bearbeiten</button>
    <button type="button" id="bulk-clear" class="btn btn-outline-secondary">Auswahl aufheben</button>
    <button type="submit" class="btn btn-outline-danger">Löschen …</button>
  </form>
<% } %>
<% if (_hasDrafts) { %>
  <!-- Drop-Ziel: Foto hierher ziehen, um dafür eine neue Anzeige anzulegen.
       (report-table.js zieht es beim Drag-Start als Zwischenzeile direkt unter
       den Quell-Eintrag; data-queue reicht die Review-Queue an neue Zeilen weiter.) -->
  <div id="drop-new-draft" data-queue="<%= _queueId || '' %>"
       class="border border-2 border-dashed rounded text-center text-muted py-2 mt-2 mx-3 mb-3 small">
    ➕ Foto hierher ziehen, um eine <strong>neue Anzeige</strong> daraus zu erstellen
  </div>
<% } %>

<script src="/public/js/report-bulk.js" defer></script>
