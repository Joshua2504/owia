<%
// Gemeinsame Anzeigen-Tabelle für Dashboard und Foto-Import-Übersicht.
// Zeile: report-row.ejs. Bearbeitet wird
//   - direkt in der Zeile (Kennzeichen, Fahrzeug, Tatzeit, Tatort, Verstoß: report-inline.js),
//   - komplett im Editor-Modal (report-modal.js, „Bearbeiten"),
//   - gemeinsam für mehrere Entwürfe (report-bulk.js).
// Erwartet: reports (Felder s. report-row.ejs inkl. status), imagesByReport
// ({ reportId: [{ id, v, ok, plate }] }), optional queueId (Edit-Links öffnen die
// Review-Queue des Batches).
// Thumbnails: Klick = Vorschau/Lupe (image-preview.js), bei Entwürfen stattdessen
// der Prüf-Dialog (photo-edit.js, ok = geprüft), Ziehen = in anderen Entwurf
// verschieben (report-table.js).
const _queueId = typeof queueId !== 'undefined' && queueId ? queueId : null
const _hasDrafts = reports.some((r) => r.status === 'entwurf')
// Mögliche Doppel-Anzeigen (services/duplicates.ts): Hinweis oben + Badge in der Zeile.
const _dupGroups = (typeof duplicateGroups !== 'undefined' && duplicateGroups) || []
const _dupAz = new Set(_dupGroups.flatMap((g) => g.reports.map((x) => x.aktenzeichen)))
const _back = (typeof mergeBack !== 'undefined' && mergeBack) || '/anzeigen'
const _dFmt = (r) => h.fmtDate(r.tattag, '—') + (r.tatzeit_von ? ' ' + h.hhmm(r.tatzeit_von) : '')
%>
<% if (_dupGroups.length) { %>
  <div class="alert alert-warning m-3 mb-0 dup-hint" role="status">
    <strong>⚠️ Mögliche Doppel-Anzeigen:</strong> gleiches Kennzeichen im selben Zeitraum.
    Wenn es derselbe Vorfall ist, führe die Entwürfe zusammen (Fotos wandern in den gewählten Entwurf, die übrigen werden gelöscht).
    <% _dupGroups.forEach((g, gi) => { %>
      <form method="post" action="/anzeigen/zusammenfuehren" class="dup-group mt-2 pt-2 border-top"
            data-confirm="Entwürfe wirklich zusammenführen? Die übrigen Entwürfe werden danach gelöscht.">
        <input type="hidden" name="back" value="<%= _back %>">
        <%- h.plate(g.kennzeichen, null, 'me-2') %>
        <% const _firstDraft = g.reports.find((x) => x.status === 'entwurf') %>
        <% for (const x of g.reports) { %>
          <span class="d-inline-flex align-items-center gap-1 me-3 small">
            <% if (g.mergeable && x.status === 'entwurf') { %>
              <input type="hidden" name="az" value="<%= x.aktenzeichen %>">
              <input type="radio" class="form-check-input" name="target" value="<%= x.aktenzeichen %>"
                     id="dup-<%= gi %>-<%= x.aktenzeichen %>" <%= x === _firstDraft ? 'checked' : '' %>
                     title="Diesen Entwurf behalten">
            <% } %>
            <label for="dup-<%= gi %>-<%= x.aktenzeichen %>"><a href="#" data-dup-jump="<%= x.aktenzeichen %>"><%= x.aktenzeichen %></a>
              · <%= _dFmt(x) %><% if (x.status !== 'entwurf') { %> · <em><%= x.status %></em><% } %></label>
          </span>
        <% } %>
        <% if (g.mergeable) { %>
          <button type="submit" class="btn btn-sm btn-warning">Zusammenführen</button>
          <span class="small text-muted">(ausgewählter Entwurf bleibt)</span>
        <% } else { %>
          <span class="small text-muted">Bereits eingereicht – bitte prüfen, ob der Entwurf noch nötig ist.</span>
        <% } %>
      </form>
    <% }) %>
  </div>
  <%# Klick auf ein Aktenzeichen im Hinweis springt zur Zeile: report-table.js (data-dup-jump). %>
<% } %>
<%# Ab md eine Tabelle, darunter Karten (Regeln in app.css, Zellklassen in
    report-row.ejs) – der Großteil der Nutzer kommt per Handy und soll nicht
    seitwärts scrollen müssen. Das Markup bleibt bewusst eine Tabelle, weil
    report-table.js an <tr data-drop-az> hängt. %>
<div class="report-filters">
  <label class="report-filter-search">
    <span class="visually-hidden">Suchen</span>
    <input type="search" id="report-search" class="form-control" placeholder="🔍 Kennzeichen, Aktenzeichen, Tatort, Verstoß …">
  </label>
  <%# Status-Filter mit Mehrfachauswahl (report-bulk.js): nichts gewählt = alle. %>
  <div class="status-chips" id="report-status" role="group" aria-label="Nach Status filtern">
    <% for (const [v, label] of [['entwurf', 'Entwürfe'], ['bereit', 'Bereit'], ['eingereicht', 'Eingereicht'], ['versendet', 'Versendet']]) { %>
      <input type="checkbox" class="btn-check" id="status-<%= v %>" value="<%= v %>" autocomplete="off">
      <label class="btn btn-sm btn-outline-secondary" for="status-<%= v %>"><%= label %></label>
    <% } %>
  </div>
  <% if (_hasDrafts) { %><label class="d-md-none d-flex align-items-center gap-2 report-select-label"><input type="checkbox" id="bulk-select-all-m" class="form-check-input"> Alle Entwürfe</label><% } %>
  <span id="report-visible-count" class="small text-muted ms-auto" role="status"></span>
</div>
<div class="report-table-wrap">
  <table class="table table-hover align-middle mb-0 report-table">
    <thead>
      <tr>
        <th class="cell-select">
          <% if (_hasDrafts) { %>
            <label class="report-checkbox-target" title="Alle sichtbaren Entwürfe auswählen">
              <input type="checkbox" id="bulk-select-all" class="form-check-input" aria-label="Alle sichtbaren Entwürfe auswählen">
            </label>
          <% } %>
        </th>
        <%# Spaltenköpfe sortieren server-seitig (routes/dashboard.ts übergibt sort);
            erneuter Klick dreht die Richtung. Ohne sort (Import-Übersicht) bleibt
            die Reihenfolge der Seite. %>
        <% for (const [key, label] of [['photos', 'Fotos'], ['az', 'Aktenzeichen'], ['plate', 'Kennzeichen / Fahrzeug'], ['ts', 'Tatzeit'], ['place', 'Tatort'], ['offense', 'Verstoß'], ['status', 'Status']]) { %>
          <% if (typeof sort !== 'undefined' && sort) { %>
            <% const _on = sort.key === key %>
            <% const _next = _on ? (sort.dir === 'asc' ? 'desc' : 'asc') : (key === 'ts' || key === 'photos' ? 'desc' : 'asc') %>
            <th aria-sort="<%= _on ? (sort.dir === 'asc' ? 'ascending' : 'descending') : 'none' %>">
              <a class="sort-btn" href="?sort=<%= key %>&amp;dir=<%= _next %>"><%= label %> <span aria-hidden="true"><%= _on ? (sort.dir === 'asc' ? '▲' : '▼') : '' %></span></a>
            </th>
          <% } else { %>
            <th><%= label %></th>
          <% } %>
        <% } %>
        <th><span class="visually-hidden">Aktionen</span></th>
      </tr>
    </thead>
    <tbody>
      <% for (const r of reports) { %>
        <%- include('report-row', {
          r,
          imgs: (typeof imagesByReport !== 'undefined' && imagesByReport && imagesByReport[r.id]) || [],
          queueId: _queueId,
          isDuplicate: _dupAz.has(r.aktenzeichen),
        }) %>
      <% } %>
    </tbody>
  </table>
</div>
<%# Vorschlagslisten für Marke/Farbe der Inline-Felder (report-row.ejs) – einmal
    je Tabelle statt je Zeile (eindeutige IDs). Nachgeladene Zeilen nutzen sie mit. %>
<datalist id="fz-marken"><% (typeof fahrzeugMarken !== 'undefined' ? fahrzeugMarken : []).forEach(function (m) { %><option value="<%= m %>"><% }) %></datalist>
<datalist id="fz-farben"><% (typeof fahrzeugFarben !== 'undefined' ? fahrzeugFarben : []).forEach(function (f) { %><option value="<%= f %>"><% }) %></datalist>
<% if (_hasDrafts) { %>
  <!-- Aktionsleiste für angehakte Entwürfe. Die Checkboxen in den Zeilen
       hängen per form-Attribut an diesem Formular (Zeilen enthalten bereits
       eigene Einzel-Löschen-Formulare, Verschachtelung ist nicht erlaubt).
       Löschen verschiebt in den Papierkorb. -->
  <form id="bulk-discard-form" method="post" action="/anzeigen/loeschen"
        class="d-none align-items-center flex-wrap gap-2 bulk-action-bar">
    <span id="bulk-count" class="fw-semibold" role="status"></span>
    <button type="button" id="bulk-edit" class="btn btn-primary">Gemeinsam bearbeiten</button>
    <button type="submit" class="btn btn-outline-danger">🗑 In den Papierkorb</button>
    <button type="button" id="bulk-clear" class="btn btn-link">Auswahl aufheben</button>
  </form>
  <!-- Drop-Ziel: Foto hierher ziehen, um dafür eine neue Anzeige anzulegen.
       (report-table.js zieht es beim Drag-Start als Zwischenzeile direkt unter
       den Quell-Eintrag; data-queue reicht die Review-Queue an neue Zeilen weiter.)
       Nur während eines Drags sichtbar (.is-dragging am body). -->
  <div id="drop-new-draft" data-queue="<%= _queueId || '' %>" class="drop-new-draft">
    ➕ Foto hier ablegen, um eine <strong>neue Anzeige</strong> daraus zu erstellen
  </div>
<% } %>

<script src="/public/js/verstoss-select.js" defer></script>
<script src="/public/js/report-bulk.js" defer></script>
<script src="/public/js/report-inline.js" defer></script>
<script src="/public/js/report-modal.js" defer></script>
<script src="/public/js/photo-picks.js" defer></script>
<script src="/public/js/photo-edit.js" defer></script>
<script src="/public/js/report-submit.js" defer></script>
