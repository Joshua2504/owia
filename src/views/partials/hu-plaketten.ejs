<%# HU-Plaketten: gültige und abgelaufene Jahrgänge (Daten: services/huPlakette.ts) %>
<% const badge = (p, dim) => { %>
  <div class="text-center" style="width:5.5rem<%= dim ? ';opacity:.55' : '' %>">
    <svg viewBox="0 0 100 100" width="64" height="64" role="img"
         aria-label="HU-Plakette <%= p.year %> (<%= p.color.name %>)">
      <circle cx="50" cy="50" r="46" fill="<%= p.color.bg %>" stroke="rgba(0,0,0,.35)" stroke-width="2"/>
      <% for (let i = 0; i < 12; i++) { const a = (i * 30 - 60) * Math.PI / 180 %>
        <text x="<%= (50 + 35 * Math.cos(a)).toFixed(1) %>" y="<%= (50 + 35 * Math.sin(a) + 4).toFixed(1) %>"
              text-anchor="middle" font-size="11" font-weight="600" fill="<%= p.color.fg %>"><%= i + 1 %></text>
      <% } %>
      <text x="50" y="57" text-anchor="middle" font-size="20" font-weight="700" fill="<%= p.color.fg %>"><%= String(p.year).slice(2) %></text>
      <% if (dim) { %><line x1="18" y1="82" x2="82" y2="18" stroke="#c00" stroke-width="6" stroke-linecap="round"/><% } %>
    </svg>
    <div class="fw-semibold small"><%= p.year %></div>
    <div class="text-muted" style="font-size:.75rem"><%= p.note %></div>
  </div>
<% } %>
<section class="mb-5">
  <h2 class="h4 mb-1 text-center">Welche TÜV-Plaketten gelten gerade?</h2>
  <p class="text-muted small text-center mb-3">
    Stand <%= huPlaketten.today %>. Die HU-Plakette gilt bis zum Ende des oben angezeigten Monats.
  </p>
  <div class="row g-3">
    <div class="col-md-6">
      <div class="card h-100 shadow-sm border-success-subtle"><div class="card-body">
        <h3 class="h6 text-success mb-3">✅ Gültig</h3>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <% huPlaketten.valid.forEach((p) => badge(p, false)) %>
        </div>
      </div></div>
    </div>
    <div class="col-md-6">
      <div class="card h-100 shadow-sm border-danger-subtle"><div class="card-body">
        <h3 class="h6 text-danger mb-3">⛔ Abgelaufen</h3>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <% huPlaketten.expired.forEach((p) => badge(p, true)) %>
        </div>
      </div></div>
    </div>
  </div>
</section>
