<%
// EINE Zeile der Anzeigen-Tabelle (siehe report-table.ejs). Eigenständig
// renderbar: GET /anzeige/:az/listenzeile liefert sie als HTML-Fragment, damit
// die Tabelle nach Drag & Drop, Inline- oder Modal-Bearbeitung ohne
// Seiten-Reload aktualisiert werden kann.
// Erwartet: r (Anzeige inkl. reply_count/unread_reply_count), imgs
// ([{ id, v }] – v = Versionskennung der Bildfassung für Cache-Busting, s.
// imageVersion() in routes/reports.ts), queueId.
//
// Die Zellen tragen feste `cell-*`-Klassen: ab md ist das eine normale
// Tabellenzeile, darunter macht app.css daraus eine Karte (Reihenfolge per
// `order`, Beschriftung per .cell-label). Leere Zellen bekommen `cell-empty`
// und verschwinden in der Kartenansicht – `:empty` greift nicht, weil EJS
// Zeilenumbrüche im <td> hinterlässt.
//
// Entwürfe: Kennzeichen, Fahrzeugmarke und Verstoß sind direkt in der Zeile
// editierbar (public/js/report-inline.js, PATCH /anzeige/:az/felder).
const _fmtDate = (d) => (d ? new Date(d).toLocaleDateString('de-DE') : '')
const _hhmm = (t) => (t ? String(t).slice(0, 5) : '')
const _queue = queueId ? '?queue=' + queueId : ''
const _isDraft = r.status === 'entwurf'
const _imgs = (typeof imgs !== 'undefined' && imgs) || []
%>
<%
// Sortierschlüssel Tatzeit (report-bulk.js): „YYYY-MM-DD HH:MM", leer = ohne Datum.
const _ts = (() => { if (!r.tattag) return ''; const d = new Date(r.tattag); if (isNaN(d)) return ''; return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0') + ' ' + (r.tatzeit_von ? String(r.tatzeit_von).slice(0, 5) : '00:00') })()
%>
<tr data-status="<%= _isDraft && r.bereit_at ? 'bereit' : r.status %>" data-az="<%= r.aktenzeichen %>" data-sort-ts="<%= _ts %>" <% if (_isDraft) { %>data-drop-az="<%= r.aktenzeichen %>"<% } %>>
  <td class="cell-select <%= _isDraft ? '' : 'cell-empty' %>">
    <% if (_isDraft) { %>
      <%# Mehrfachauswahl für gemeinsame Aktionen (Formular in report-table.ejs). %>
      <label class="report-checkbox-target">
      <input type="checkbox" class="form-check-input bulk-select" name="az"
             value="<%= r.aktenzeichen %>" form="bulk-discard-form"
             aria-label="Entwurf <%= r.aktenzeichen %> auswählen">
      </label>
    <% } %>
  </td>
  <td class="cell-photos <%= _imgs.length ? '' : 'cell-empty' %>">
    <div class="report-photos" data-photos>
      <%# Nicht mehr bearbeitbare Anzeigen kompakt: höchstens eine Reihe (3 Kacheln),
          bei mehr Fotos 2 + „+N" (Link zur Detailseite). Entwürfe zeigen alle. %>
      <% const _shown = _isDraft || _imgs.length <= 3 ? _imgs : _imgs.slice(0, 2) %>
      <% for (const img of _shown) { %>
        <%# thumb-wrap: Hülle für das Auswahl-Häkchen (photo-picks.js, nur Entwürfe). %>
        <span class="thumb-wrap">
        <img src="/anzeige/<%= r.aktenzeichen %>/image/<%= img.id %>/thumb.jpg?v=<%= img.v %>" alt="Beweisfoto"
             class="report-thumb" loading="lazy" decoding="async"
             data-full-src="/anzeige/<%= r.aktenzeichen %>/image/<%= img.id %>?v=<%= img.v %>"
             <% if (_isDraft) { %>
               draggable="true" data-drag-image="<%= img.id %>" data-drag-az="<%= r.aktenzeichen %>"
               data-photo-edit="/anzeige/<%= r.aktenzeichen %>/images/<%= img.id %>"
               title="Klick: Vorschau (Schwärzen/Zuschneiden) · Strg-Klick: auswählen · Ziehen: verschieben"
             <% } else { %>
               title="Klick: Vorschau"
             <% } %>>
        <% if (_isDraft) { %>
          <input type="checkbox" class="thumb-pick" data-pick-az="<%= r.aktenzeichen %>" data-pick-id="<%= img.id %>"
                 aria-label="Foto zum Verschieben auswählen" title="Foto auswählen">
        <% } %>
        </span>
      <% } %>
      <% if (_shown.length < _imgs.length) { %>
        <a class="report-photos-more" href="/anzeige/<%= r.aktenzeichen %>" title="Alle <%= _imgs.length %> Fotos ansehen">+<%= _imgs.length - _shown.length %></a>
      <% } %>
    </div>
  </td>
  <td class="cell-az text-nowrap">
    <a href="/anzeige/<%= r.aktenzeichen %><%= _isDraft ? '/bearbeiten' + _queue : '' %>" class="az-link"
       <% if (_isDraft) { %>data-edit-modal<% } %>><%= r.aktenzeichen || '—' %></a>
  </td>
  <td class="cell-plate <%= _isDraft || r.kennzeichen || r.fahrzeug_marke ? '' : 'cell-empty' %>">
    <% if (_isDraft) { %>
      <span class="cell-label">Kennzeichen / Marke</span>
      <input type="text" class="form-control form-control-sm inline-input plate-field" data-inline-field="kennzeichen"
             value="<%= r.kennzeichen || '' %>" placeholder="Kennzeichen" maxlength="20"
             autocomplete="off" spellcheck="false" autocapitalize="characters"
             aria-label="Kennzeichen von <%= r.aktenzeichen %>">
      <input type="text" class="form-control form-control-sm inline-input inline-sub" data-inline-field="fahrzeug_marke"
             value="<%= r.fahrzeug_marke || '' %>" placeholder="Marke / Farbe" maxlength="100"
             autocomplete="off" aria-label="Fahrzeugmarke von <%= r.aktenzeichen %>">
      <%# Von der Kennzeichen-Erkennung gelesene Kennzeichen der Fotos, die noch
          nicht im Feld stehen: Klick übernimmt (report-inline.js). %>
      <% const _norm = (p) => String(p || '').toUpperCase().replace(/[^A-Z0-9ÄÖÜ]/g, '') %>
      <% const _plates = String(r.detected_plates || '').split('|').filter((p) => p && _norm(p) !== _norm(r.kennzeichen)).slice(0, 3) %>
      <% for (const p of _plates) { %>
        <button type="button" class="btn btn-link p-0 d-block small plate-suggest" data-plate-suggest="<%= p %>"
                title="Aus den Fotos erkannt – übernehmen">🚗 <%= p %> übernehmen</button>
      <% } %>
    <% } else { %>
      <% if (r.kennzeichen) { %>
        <span class="plate-chip"><% if (r.kennzeichen_land && r.kennzeichen_land !== 'D') { %><small><%= r.kennzeichen_land %></small><% } %><%= r.kennzeichen %></span>
      <% } %>
      <% if (r.fahrzeug_marke) { %>
        <div class="text-muted small mt-1"><%= r.fahrzeug_marke %></div>
      <% } %>
    <% } %>
  </td>
  <%
  // YYYY-MM-DD für <input type="date"> – lokale Datumsteile, kein toISOString (UTC-Versatz).
  const _isoDate = (d) => { if (!d) return ''; const x = new Date(d); return isNaN(x) ? '' : x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0') + '-' + String(x.getDate()).padStart(2, '0') }
  %>
  <td class="cell-time text-nowrap">
    <span class="cell-label">Tatzeit</span>
    <% if (_isDraft) { %>
      <%# Tattag + Uhrzeit von/bis direkt bearbeiten (report-inline.js). %>
      <input type="date" class="form-control form-control-sm inline-input" data-inline-field="tattag"
             value="<%= _isoDate(r.tattag) %>" aria-label="Tattag von <%= r.aktenzeichen %>">
      <div class="inline-times">
        <input type="time" class="form-control form-control-sm inline-input" data-inline-field="tatzeit_von"
               value="<%= _hhmm(r.tatzeit_von) %>" aria-label="Uhrzeit von">
        <span class="text-muted">–</span>
        <input type="time" class="form-control form-control-sm inline-input" data-inline-field="tatzeit_bis"
               value="<%= _hhmm(r.tatzeit_bis) %>" aria-label="Uhrzeit bis">
      </div>
    <% } else { %>
    <%= _fmtDate(r.tattag) || '—' %><% if (r.tattag_bis && _fmtDate(r.tattag_bis) !== _fmtDate(r.tattag)) { %> – <%= _fmtDate(r.tattag_bis) %><% } %>
    <% const von = _hhmm(r.tatzeit_von), bis = _hhmm(r.tatzeit_bis) %>
    <% if (von) { %>
      <div class="cell-sub text-muted small">
        <%= von %><% if (bis && bis !== von) { %> – <%= bis %><% } %> Uhr
      </div>
    <% } %>
    <% } %>
  </td>
  <%
  // Karten-Icon nur mit gültigen Koordinaten (0/0 = Altbestand, s. persistFields).
  const _lat = Number(r.tatort_lat), _lon = Number(r.tatort_lon)
  const _hasCoords = Number.isFinite(_lat) && Number.isFinite(_lon) && _lat !== 0 && _lon !== 0
  %>
  <td class="cell-place small <%= r.tatort || _isDraft ? '' : 'cell-empty' %>">
    <% if (r.tatort || _isDraft) { %><span class="cell-label">Tatort</span><% } %>
    <div class="tatort-cell">
      <% if (_isDraft) { %>
        <%# Adresse direkt hier ändern: Vorschläge wie im Editor (address-autocomplete.js,
            lazy initialisiert in report-inline.js), Speichern per PATCH /felder. %>
        <textarea class="form-control form-control-sm inline-input<%= r.tatort ? '' : ' is-missing' %>" data-inline-field="tatort"
                  rows="2" data-geo-scope="unlocked" data-fill="full" data-ac-local
                  placeholder="Tatort fehlt – Adresse eingeben" autocomplete="off" spellcheck="false"
                  aria-label="Tatort von <%= r.aktenzeichen %>"><%= r.tatort || '' %></textarea>
      <% } else { %>
        <span class="clamp-2" title="<%= r.tatort || '' %>"><%= r.tatort || '' %></span>
      <% } %>
      <% if (_hasCoords) { %>
        <button type="button" class="map-peek" data-map-peek data-lat="<%= _lat %>" data-lon="<%= _lon %>"
                title="Karte anzeigen" aria-label="Tatort auf der Karte anzeigen">🗺️</button>
      <% } %>
    </div>
    <%# Fehlender Tatort, aber Fotos mit GPS: per Klick übernehmen (report-inline.js). %>
    <% if (!r.tatort && _isDraft && Number(r.photo_gps_count) > 0) { %>
      <button type="button" class="btn btn-link p-0 d-block small tatort-from-photos" data-tatort-from-photos>📍 aus Fotos übernehmen</button>
    <% } %>
  </td>
  <%
  // Weitere Details kompakt darunter (nur befüllte Felder).
  const extras = []
  // Entwürfe zeigen Verlassen/Behinderung als Häkchen (unten), nicht als Text.
  if (!_isDraft && r.fahrzeug_verlassen === 1) extras.push('Fahrzeug war verlassen')
  if (!_isDraft && r.behinderung === 1) extras.push('Behinderung: ' + (r.behinderung_text || 'ja'))
  if (r.beschreibung) extras.push(r.beschreibung)
  %>
  <td class="cell-offense small <%= _isDraft || r.verstoss_art || extras.length ? '' : 'cell-empty' %>">
    <span class="cell-label">Verstoß</span>
    <% if (_isDraft) { %>
      <%# Durchsuchbare Auswahl wie im Editor; der Katalog wird erst beim
          ersten Fokus geladen (report-inline.js → verstoss-select.js). %>
      <div class="position-relative inline-verstoss" data-inline-verstoss>
        <input type="hidden" data-inline-field="verstoss_art" value="<%= r.verstoss_art || '' %>">
        <textarea class="form-control form-control-sm inline-input" data-verstoss-input rows="2"
                  autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false"
                  placeholder="Verstoß wählen …" title="<%= r.verstoss_art || '' %>"
                  aria-label="Verstoß von <%= r.aktenzeichen %>"><%= r.verstoss_art || '' %></textarea>
      </div>
      <div class="inline-flags">
        <label><input type="checkbox" class="form-check-input" data-inline-field="fahrzeug_verlassen" <%= r.fahrzeug_verlassen === 1 ? 'checked' : '' %>> Fahrzeug verlassen</label>
        <label><input type="checkbox" class="form-check-input" data-inline-field="behinderung" <%= r.behinderung === 1 ? 'checked' : '' %>> Behinderung</label>
      </div>
      <input type="text" class="form-control form-control-sm inline-input inline-sub" data-inline-field="behinderung_text"
             value="<%= r.behinderung_text || '' %>" placeholder="Wer wurde wie behindert?" maxlength="2000"
             <%= r.behinderung === 1 ? '' : 'hidden' %> aria-label="Behinderung beschreiben">
    <% } else { %>
      <div class="clamp-2" title="<%= r.verstoss_art || '' %>"><%= r.verstoss_art || '' %></div>
    <% } %>
    <% if (extras.length) { %>
      <div class="cell-sub text-muted small text-truncate" title="<%= extras.join(' · ') %>"><%= extras.join(' · ') %></div>
    <% } %>
  </td>
  <td class="cell-status">
    <% if (r.status === 'versendet') { %>
      <span class="badge rounded-pill text-bg-success">Versendet</span>
    <% } else if (_isDraft) { %>
      <%# Status Entwurf ⇄ Bereit per Klick umschalten (report-table.js). „Bereit"
          ist eine Markierung am Entwurf (bereit_at) – bleibt also voll bearbeitbar. %>
      <form method="post" action="/anzeige/<%= r.aktenzeichen %>/bereit" class="d-inline m-0" data-bereit-toggle>
        <button type="submit" class="badge rounded-pill border-0 <%= r.bereit_at ? 'text-bg-primary' : 'text-bg-warning' %>"
                title="<%= r.bereit_at ? 'Bereit zum Einreichen – Klick: zurück auf Entwurf' : 'Entwurf – Klick: als bereit markieren' %>"><%= r.bereit_at ? '✔ Bereit' : 'Entwurf' %></button>
      </form>
      <% const _vj = verjaehrung(r) %>
      <% if (_vj.verjaehrt) { %>
        <span class="badge rounded-pill text-bg-danger" title="Tat liegt mehr als drei Monate zurück – kann nicht mehr eingereicht werden">⌛ Verjährt</span>
      <% } else if (_vj.bald) { %>
        <span class="badge rounded-pill text-bg-light border" title="Verjährt in <%= _vj.restTage %> Tag<%= _vj.restTage === 1 ? '' : 'en' %>">⏳ noch <%= _vj.restTage %> T.</span>
      <% } %>
    <% } else { %>
      <span class="badge rounded-pill text-bg-info">Eingereicht</span>
    <% } %>
    <% if (typeof isDuplicate !== 'undefined' && isDuplicate) { %>
      <span class="badge rounded-pill text-bg-warning border border-dark-subtle" title="Gleiches Kennzeichen im selben Zeitraum – siehe Hinweis oben">⚠️ Doppelt?</span>
    <% } %>
    <%# Antwort des Ordnungsamts liegt vor (Spalten liefert nur das Dashboard). %>
    <% if (r.reply_count) { %>
      <a href="/anzeige/<%= r.aktenzeichen %>" class="badge rounded-pill text-bg-primary text-decoration-none"
         title="Antwort des Ordnungsamts ansehen">
        📨 Antwort<%= r.reply_count > 1 ? ' (' + r.reply_count + ')' : '' %><%= r.unread_reply_count > 0 ? ' • neu' : '' %>
      </a>
    <% } %>
  </td>
  <td class="cell-actions">
    <div class="d-flex gap-1 justify-content-end">
      <% if (_isDraft) { %>
        <%# Öffnet den Editor im Modal (report-modal.js); Strg-/Mittelklick = neuer Tab. %>
        <%# Einreichen: Modal mit Datenvorschau + PDF (report-submit.js). %>
        <button type="button" class="btn btn-sm btn-success" data-submit-preview title="Prüfen und einreichen">Einreichen</button>
        <a href="/anzeige/<%= r.aktenzeichen %>/bearbeiten<%= _queue %>" class="btn btn-sm btn-outline-primary" data-edit-modal title="Alle Angaben im Editor">✏️</a>
        <%# Löschen verschiebt in den Papierkorb (wiederherstellbar). %>
        <form method="post" action="/anzeige/<%= r.aktenzeichen %>/discard" class="m-0">
          <button type="submit" class="btn btn-sm btn-outline-danger" title="In den Papierkorb" aria-label="Entwurf <%= r.aktenzeichen %> in den Papierkorb verschieben">🗑</button>
        </form>
      <% } else { %>
        <a href="/anzeige/<%= r.aktenzeichen %>" class="btn btn-sm btn-outline-secondary">Details</a>
      <% } %>
    </div>
  </td>
</tr>
