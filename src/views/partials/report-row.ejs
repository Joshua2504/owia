<%
// EINE Zeile der Anzeigen-Tabelle (siehe report-table.ejs). Eigenständig
// renderbar: GET /anzeige/:az/listenzeile liefert sie als HTML-Fragment, damit
// die Tabelle nach Drag & Drop ("Foto in neue Anzeige") ohne Seiten-Reload
// ergänzt werden kann.
// Erwartet: r (Anzeige inkl. reply_count/unread_reply_count), imgIds, queueId.
//
// Die Zellen tragen feste `cell-*`-Klassen: ab md ist das eine normale
// Tabellenzeile, darunter macht app.css daraus eine Karte (Reihenfolge per
// `order`, Beschriftung per .cell-label). Leere Zellen bekommen `cell-empty`
// und verschwinden in der Kartenansicht – `:empty` greift nicht, weil EJS
// Zeilenumbrüche im <td> hinterlässt.
const _fmtDate = (d) => (d ? new Date(d).toLocaleDateString('de-DE') : '')
const _hhmm = (t) => (t ? String(t).slice(0, 5) : '')
const _queue = queueId ? '?queue=' + queueId : ''
const _isDraft = r.status === 'entwurf'
%>
<tr data-status="<%= r.status %>" <% if (_isDraft) { %>data-drop-az="<%= r.aktenzeichen %>"<% } %>>
  <td class="cell-select <%= _isDraft ? '' : 'cell-empty' %>">
    <% if (_isDraft) { %>
      <%# Mehrfachauswahl für gemeinsame Aktionen (Formular in report-table.ejs). %>
      <label class="report-checkbox-target">
      <input type="checkbox" class="form-check-input bulk-select" name="az"
             value="<%= r.aktenzeichen %>" form="bulk-discard-form"
             aria-label="Entwurf <%= r.aktenzeichen %> auswählen">
      </label>
    <% } %>
  </td>
  <td class="cell-photos <%= imgIds.length ? '' : 'cell-empty' %>">
    <div class="d-flex flex-wrap gap-1" data-photos>
      <% for (const imgId of imgIds) { %>
        <div class="report-photo">
        <img src="/anzeige/<%= r.aktenzeichen %>/image/<%= imgId %>/thumb.jpg" alt=""
             class="rounded border report-thumb" style="cursor:zoom-in"
             loading="lazy" decoding="async"
             data-full-src="/anzeige/<%= r.aktenzeichen %>/image/<%= imgId %>"
             <% if (_isDraft) { %>
               draggable="true" data-drag-image="<%= imgId %>" data-drag-az="<%= r.aktenzeichen %>"
               title="Klick: vergrößern · Ziehen: in anderen Entwurf verschieben"
             <% } else { %>
               title="Klick: vergrößern"
             <% } %>>
        <% if (_isDraft) { %><button type="button" class="btn btn-outline-secondary btn-sm photo-move" aria-label="Foto aus <%= r.aktenzeichen %> verschieben" title="Foto verschieben">↗</button><% } %>
        </div>
      <% } %>
    </div>
  </td>
  <td class="cell-az text-nowrap"><code class="small"><%= r.aktenzeichen || '—' %></code></td>
  <td class="cell-plate <%= r.kennzeichen || r.fahrzeug_marke ? '' : 'cell-empty' %>">
    <% if (r.kennzeichen) { %>
      <span class="plate-badge"><%- include('euband', { land: r.kennzeichen_land }) %><span class="plate-text"><%= r.kennzeichen %></span></span>
    <% } %>
    <% if (r.fahrzeug_marke) { %>
      <div class="text-muted small"><%= r.fahrzeug_marke %></div>
    <% } %>
  </td>
  <td class="cell-time text-nowrap">
    <span class="cell-label">Tattag</span>
    <%= _fmtDate(r.tattag) || '—' %><% if (r.tattag_bis && _fmtDate(r.tattag_bis) !== _fmtDate(r.tattag)) { %> – <%= _fmtDate(r.tattag_bis) %><% } %>
    <% const von = _hhmm(r.tatzeit_von), bis = _hhmm(r.tatzeit_bis) %>
    <% if (von) { %>
      <div class="cell-sub text-muted small">
        <%= von %><% if (bis && bis !== von) { %> – <%= bis %><% } %> Uhr
      </div>
    <% } %>
  </td>
  <td class="cell-place small <%= r.tatort || _isDraft ? '' : 'cell-empty' %>">
    <% if (r.tatort || _isDraft) { %><span class="cell-label">Tatort</span><% } %>
    <%= r.tatort || '' %><% if (!r.tatort && _isDraft) { %><span class="text-muted">– bitte prüfen –</span><% } %>
  </td>
  <%
  // Weitere Details kompakt darunter (nur befüllte Felder).
  const extras = []
  if (r.fahrzeug_verlassen === 1) extras.push('Fahrzeug war verlassen')
  if (r.behinderung === 1) extras.push('Behinderung: ' + (r.behinderung_text || 'ja'))
  if (r.beschreibung) extras.push(r.beschreibung)
  %>
  <td class="cell-offense small <%= r.verstoss_art || extras.length ? '' : 'cell-empty' %>">
    <% if (r.verstoss_art || extras.length) { %><span class="cell-label">Verstoß</span><% } %>
    <div class="text-truncate" title="<%= r.verstoss_art || '' %>"><%= r.verstoss_art || '' %></div>
    <% if (extras.length) { %>
      <div class="cell-sub text-muted small text-truncate" title="<%= extras.join(' · ') %>"><%= extras.join(' · ') %></div>
    <% } %>
  </td>
  <td class="cell-status">
    <% if (r.status === 'versendet') { %>
      <span class="badge bg-success">Versendet</span>
    <% } else if (_isDraft) { %>
      <span class="badge text-bg-warning">Entwurf</span>
    <% } else { %>
      <span class="badge bg-info">Eingereicht</span>
    <% } %>
    <%# Antwort des Ordnungsamts liegt vor (Spalten liefert nur das Dashboard). %>
    <% if (r.reply_count) { %>
      <a href="/anzeige/<%= r.aktenzeichen %>" class="badge text-bg-primary text-decoration-none"
         title="Antwort des Ordnungsamts ansehen">
        📨 Antwort<%= r.reply_count > 1 ? ' (' + r.reply_count + ')' : '' %><%= r.unread_reply_count > 0 ? ' • neu' : '' %>
      </a>
    <% } %>
  </td>
  <td class="cell-actions">
    <div class="d-flex gap-2 justify-content-end">
      <% if (_isDraft) { %>
        <a href="/anzeige/<%= r.aktenzeichen %>/bearbeiten<%= _queue %>" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
        <%# Löschen führt erst auf eine Bestätigungsseite (serverseitig erzwungen). %>
        <form method="post" action="/anzeige/<%= r.aktenzeichen %>/discard" class="m-0">
          <button type="submit" class="btn btn-sm btn-outline-danger">Löschen</button>
        </form>
      <% } else { %>
        <a href="/anzeige/<%= r.aktenzeichen %>" class="btn btn-sm btn-outline-secondary">Details</a>
      <% } %>
    </div>
  </td>
</tr>
