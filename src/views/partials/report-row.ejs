<%
// EINE Zeile der Anzeigen-Tabelle (siehe report-table.ejs). Eigenständig
// renderbar: GET /anzeige/:az/listenzeile liefert sie als HTML-Fragment, damit
// die Tabelle nach Drag & Drop, Inline- oder Modal-Bearbeitung ohne
// Seiten-Reload aktualisiert werden kann.
// Erwartet: r (Anzeige inkl. reply_count/unread_reply_count), imgs
// ([{ id, v, ok, plate }] – ok = Foto geprüft, plate = ALPR-Ergebnis des Fotos, v = Versionskennung der Bildfassung für Cache-Busting, s.
// imageVersion() in routes/reports.ts), queueId.
//
// Die Zellen tragen feste `cell-*`-Klassen: ab md ist das eine normale
// Tabellenzeile, darunter macht app.css daraus eine Karte (Reihenfolge per
// `order`, Beschriftung per .cell-label). Leere Zellen bekommen `cell-empty`
// und verschwinden in der Kartenansicht – `:empty` greift nicht, weil EJS
// Zeilenumbrüche im <td> hinterlässt.
//
// Entwürfe: Kennzeichen, Fahrzeug (Marke/Modell/Typ/Farbe), Tatzeit, Tatort und
// Verstoß sind direkt in der Zeile editierbar (public/js/report-inline.js,
// PATCH /anzeige/:az/felder). Erwartet dafür fahrzeugTypen (defaultContext in
// server.ts bzw. explizit bei ejs.renderFile); die Datalists fz-marken/fz-farben
// stellt report-table.ejs bereit.
const _hhmm = h.hhmm
const _queue = queueId ? '?queue=' + queueId : ''
const _isDraft = r.status === 'entwurf'
const _imgs = (typeof imgs !== 'undefined' && imgs) || []
const _typen = (typeof fahrzeugTypen !== 'undefined' && fahrzeugTypen) || ['PKW']
%>
<%
// Sortierschlüssel Tatzeit (report-bulk.js): „YYYY-MM-DD HH:MM", leer = ohne Datum.
const _ts = r.tattag && h.isoDate(r.tattag) ? h.isoDate(r.tattag) + ' ' + (h.hhmm(r.tatzeit_von) || '00:00') : ''
%>
<tr data-status="<%= _isDraft && r.bereit_at ? 'bereit' : r.status %>" data-az="<%= r.aktenzeichen %>" data-sort-ts="<%= _ts %>" <% if (_isDraft) { %>data-drop-az="<%= r.aktenzeichen %>"<% } %>>
  <td class="cell-select <%= _isDraft ? '' : 'cell-empty' %>">
    <% if (_isDraft) { %>
      <%# Mehrfachauswahl für gemeinsame Aktionen (Formular in report-table.ejs). %>
      <label class="report-checkbox-target">
      <input type="checkbox" class="form-check-input bulk-select" name="az"
             value="<%= r.aktenzeichen %>" form="bulk-discard-form"
             aria-label="Entwurf <%= r.aktenzeichen %> auswählen">
      </label>
    <% } %>
  </td>
  <td class="cell-photos <%= _imgs.length ? '' : 'cell-empty' %>">
    <div class="report-photos" data-photos>
      <%# Nicht mehr bearbeitbare Anzeigen kompakt: höchstens eine Reihe (3 Kacheln),
          bei mehr Fotos 2 + „+N" (Link zur Detailseite). Entwürfe zeigen alle. %>
      <% const _shown = _isDraft || _imgs.length <= 3 ? _imgs : _imgs.slice(0, 2) %>
      <% for (const img of _shown) { %>
        <%# thumb-wrap: Hülle für das Auswahl-Häkchen (photo-picks.js, nur Entwürfe). %>
        <span class="thumb-wrap<%= _isDraft ? (img.ok ? ' is-geprueft' : ' is-ungeprueft') : '' %>">
        <img src="/anzeige/<%= r.aktenzeichen %>/image/<%= img.id %>/thumb.jpg?v=<%= img.v %>" alt="Beweisfoto"
             class="report-thumb" loading="lazy" decoding="async"
             data-full-src="/anzeige/<%= r.aktenzeichen %>/image/<%= img.id %>?v=<%= img.v %>"
             <% if (_isDraft) { %>
               draggable="true" data-drag-image="<%= img.id %>" data-drag-az="<%= r.aktenzeichen %>"
               data-photo-edit="/anzeige/<%= r.aktenzeichen %>/images/<%= img.id %>"
               data-geprueft="<%= img.ok ? 1 : 0 %>"
               <% if (img.zeit) { %>data-zeit="<%= img.zeit %>"<% } %>
               <% if (img.plate) { %>data-detected-plate="<%= img.plate %>"<% } %>
               title="<%= img.ok ? 'Geprüft' : 'Noch nicht geprüft' %> – Klick: prüfen/schwärzen · Strg-Klick: auswählen · Ziehen: verschieben"
             <% } else { %>
               title="Klick: Vorschau"
             <% } %>>
        <% if (_isDraft) { %>
          <span class="thumb-check" aria-hidden="true"><%= img.ok ? '✓' : '?' %></span>
<label class="thumb-pick-hit" title="Foto auswählen"><input type="checkbox" class="thumb-pick" data-pick-az="<%= r.aktenzeichen %>" data-pick-id="<%= img.id %>"
                 aria-label="Foto zum Verschieben auswählen"></label>
        <% } %>
        </span>
      <% } %>
      <% if (_shown.length < _imgs.length) { %>
        <a class="report-photos-more" href="/anzeige/<%= r.aktenzeichen %>" title="Alle <%= _imgs.length %> Fotos ansehen">+<%= _imgs.length - _shown.length %></a>
      <% } %>
    </div>
    <%# Foto-Prüfung: Einreichen erst, wenn jedes Foto bestätigt ist (photo-edit.js). %>
    <%# Verjährte Entwürfe lassen sich nicht mehr einreichen – also auch nicht prüfen. %>
    <% const _verjaehrt = _isDraft && verjaehrung(r).verjaehrt %>
    <% const _unchecked = _isDraft && !_verjaehrt ? _imgs.filter((i) => !i.ok).length : 0 %>
    <%# Kompakt (max. zwei Zeilen je Anzeige): der Prüfstand steckt in den
        Kachel-Rändern (gelb = ungeprüft) und im „Prüfen"-Knopf (Zähler). %>
  </td>
  <td class="cell-az text-nowrap">
    <a href="/anzeige/<%= r.aktenzeichen %><%= _isDraft ? '/bearbeiten' + _queue : '' %>" class="az-link"
       <% if (_isDraft) { %>data-edit-modal<% } %>><%= r.aktenzeichen || '—' %></a>
  </td>
  <td class="cell-plate <%= _isDraft || r.kennzeichen || r.fahrzeug_marke || r.fahrzeug_modell || r.fahrzeug_farbe ? '' : 'cell-empty' %>">
    <% if (_isDraft) { %>
      <span class="cell-label">Kennzeichen / Fahrzeug</span>
      <%# Von der Kennzeichen-Erkennung gelesene Kennzeichen der Fotos, die noch
          nicht im Feld stehen: Klick übernimmt (report-inline.js). Als Chip neben
          dem Feld, damit die Zeile zweizeilig bleibt. %>
      <% const _norm = (p) => String(p || '').toUpperCase().replace(/[^A-Z0-9ÄÖÜ]/g, '') %>
      <% const _plates = String(r.detected_plates || '').split('|').filter((p) => p && _norm(p) !== _norm(r.kennzeichen)).slice(0, 2) %>
      <div class="inline-line">
      <input type="text" class="form-control form-control-sm inline-input plate-field" data-inline-field="kennzeichen"
             value="<%= r.kennzeichen || '' %>" placeholder="Kennzeichen" maxlength="20"
             autocomplete="off" spellcheck="false" autocapitalize="characters"
             aria-label="Kennzeichen von <%= r.aktenzeichen %>">
      <% for (const p of _plates) { %>
        <button type="button" class="btn btn-link p-0 small plate-suggest" data-plate-suggest="<%= p %>"
                title="Aus den Fotos erkannt: <%= p %> – Klick übernimmt">🚗 <%= p %></button>
      <% } %>
      </div>
      <%# Fahrzeug wie im Editor getrennt (Migration 0039): Marke, Modell, Typ, Farbe. %>
      <div class="inline-vehicle">
        <input type="text" class="form-control form-control-sm inline-input inline-sub" data-inline-field="fahrzeug_marke"
               value="<%= r.fahrzeug_marke || '' %>" placeholder="Marke" maxlength="100" list="fz-marken"
               autocomplete="off" aria-label="Fahrzeugmarke von <%= r.aktenzeichen %>">
        <input type="text" class="form-control form-control-sm inline-input inline-sub" data-inline-field="fahrzeug_modell"
               value="<%= r.fahrzeug_modell || '' %>" placeholder="Modell" maxlength="60"
               autocomplete="off" aria-label="Fahrzeugmodell von <%= r.aktenzeichen %>">
        <select class="form-select form-select-sm inline-input inline-sub" data-inline-field="fahrzeug_typ"
                aria-label="Fahrzeugtyp von <%= r.aktenzeichen %>" title="Fahrzeugtyp">
          <% for (const t of _typen) { %><option value="<%= t %>" <%= (r.fahrzeug_typ || _typen[0]) === t ? 'selected' : '' %>><%= t %></option><% } %>
        </select>
        <input type="text" class="form-control form-control-sm inline-input inline-sub" data-inline-field="fahrzeug_farbe"
               value="<%= r.fahrzeug_farbe || '' %>" placeholder="Farbe" maxlength="40" list="fz-farben"
               autocomplete="off" aria-label="Fahrzeugfarbe von <%= r.aktenzeichen %>">
      </div>
    <% } else { %>
      <% if (r.kennzeichen) { %>
        <%- h.plate(r.kennzeichen, r.kennzeichen_land) %>
      <% } %>
      <% const _fz = [r.fahrzeug_typ, [r.fahrzeug_marke, r.fahrzeug_modell].filter(Boolean).join(' '), r.fahrzeug_farbe].filter(Boolean).join(', ') %>
      <% if (_fz) { %>
        <div class="text-muted small mt-1"><%= _fz %></div>
      <% } %>
    <% } %>
  </td>
  <td class="cell-time text-nowrap">
    <span class="cell-label">Tatzeit</span>
    <% if (_isDraft) { %>
      <%# Tattag + Uhrzeit von/bis direkt bearbeiten (report-inline.js). %>
      <div class="inline-line">
      <input type="date" class="form-control form-control-sm inline-input" data-inline-field="tattag"
             value="<%= h.isoDate(r.tattag) %>" aria-label="Tattag von <%= r.aktenzeichen %>">
      <%# Fotos haben eine andere Aufnahmezeit als eingetragen: per Klick übernehmen (report-inline.js). %>
      <% if (r.photo_time_min && r.photo_time_min !== _ts) { %>
        <button type="button" class="inline-icon-btn" data-time-from-photos
                title="Zeit aus Fotos übernehmen (aufgenommen ab <%= r.photo_time_min %>)" aria-label="Zeit aus Fotos übernehmen">🕒</button>
      <% } %>
      </div>
      <div class="inline-times">
        <input type="time" class="form-control form-control-sm inline-input" data-inline-field="tatzeit_von"
               value="<%= _hhmm(r.tatzeit_von) %>" aria-label="Uhrzeit von">
        <span class="text-muted">–</span>
        <input type="time" class="form-control form-control-sm inline-input" data-inline-field="tatzeit_bis"
               value="<%= _hhmm(r.tatzeit_bis) %>" aria-label="Uhrzeit bis">
      </div>
    <% } else { %>
    <%= h.tattage(r) %>
    <% if (r.tatzeit_von) { %>
      <div class="cell-sub text-muted small"><%= h.uhrzeit(r) %> Uhr</div>
    <% } %>
    <% } %>
  </td>
  <%
  // Karten-Icon nur mit gültigen Koordinaten (0/0 = Altbestand, s. persistFields).
  const _lat = Number(r.tatort_lat), _lon = Number(r.tatort_lon)
  const _hasCoords = Number.isFinite(_lat) && Number.isFinite(_lon) && _lat !== 0 && _lon !== 0
  %>
  <td class="cell-place small <%= r.tatort || _isDraft ? '' : 'cell-empty' %>">
    <% if (r.tatort || _isDraft) { %><span class="cell-label">Tatort</span><% } %>
    <div class="tatort-cell">
      <% if (_isDraft) { %>
        <%# Adresse direkt hier ändern: Vorschläge wie im Editor (address-autocomplete.js,
            lazy initialisiert in report-inline.js), Speichern per PATCH /felder. %>
        <textarea class="form-control form-control-sm inline-input<%= r.tatort ? '' : ' is-missing' %>" data-inline-field="tatort"
                  rows="2" data-geo-scope="unlocked" data-fill="full" data-ac-local
                  placeholder="Tatort fehlt – Adresse eingeben" autocomplete="off" spellcheck="false"
                  aria-label="Tatort von <%= r.aktenzeichen %>"><%= r.tatort || '' %></textarea>
      <% } else { %>
        <span class="clamp-2" title="<%= r.tatort || '' %>"><%= r.tatort || '' %></span>
      <% } %>
      <%# Fehlender Tatort, aber Fotos mit GPS: per Klick übernehmen (report-inline.js). %>
      <% if (!r.tatort && _isDraft && Number(r.photo_gps_count) > 0) { %>
        <button type="button" class="inline-icon-btn" data-tatort-from-photos title="Tatort aus Foto-GPS übernehmen" aria-label="Tatort aus Fotos übernehmen">📍</button>
      <% } %>
      <% if (_hasCoords) { %>
        <button type="button" class="map-peek" data-map-peek data-lat="<%= _lat %>" data-lon="<%= _lon %>"
                title="Karte anzeigen" aria-label="Tatort auf der Karte anzeigen">🗺️</button>
      <% } %>
    </div>
  </td>
  <%
  // Weitere Details kompakt darunter (nur befüllte Felder).
  const extras = []
  // Entwürfe zeigen Verlassen/Behinderung als Häkchen (unten), nicht als Text.
  if (!_isDraft && r.fahrzeug_verlassen === 1) extras.push('Fahrzeug war verlassen')
  if (!_isDraft && r.behinderung === 1) extras.push('Behinderung: ' + (r.behinderung_text || 'ja'))
  if (r.beschreibung) extras.push(r.beschreibung)
  %>
  <td class="cell-offense small <%= _isDraft || r.verstoss_art || extras.length ? '' : 'cell-empty' %>">
    <span class="cell-label">Verstoß</span>
    <% if (_isDraft) { %>
      <%# Durchsuchbare Auswahl wie im Editor; der Katalog wird erst beim
          ersten Fokus geladen (report-inline.js → verstoss-select.js). %>
      <div class="position-relative inline-verstoss" data-inline-verstoss data-city="<%= r.city || '' %>">
        <input type="hidden" data-inline-field="verstoss_art" value="<%= r.verstoss_art || '' %>">
        <%# Gesperrt = Tatbestand gibt es im Online-Portal der Stadt nicht (Frankfurt);
            verstoss-select.js hält die Markierung danach aktuell. %>
        <% const _vGesperrt = verstossGesperrt(r.city, r.verstoss_art) %>
        <textarea class="form-control form-control-sm inline-input inline-one<%= _vGesperrt ? ' is-invalid' : '' %>" data-verstoss-input rows="1"
                  autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false"<%- _vGesperrt ? ' data-gesperrt="1"' : '' %>
                  placeholder="Verstoß wählen …" title="<%= _vGesperrt ? 'Diesen Tatbestand bietet das Online-Portal der Stadt nicht an – bitte einen anderen Verstoß wählen.' : (r.verstoss_art || '') %>"
                  aria-label="Verstoß von <%= r.aktenzeichen %>"><%= r.verstoss_art || '' %></textarea>
      </div>
      <div class="inline-flags">
        <label title="Fahrzeug war verlassen (kein Fahrer in der Nähe)"><input type="checkbox" class="form-check-input" data-inline-field="fahrzeug_verlassen" <%= r.fahrzeug_verlassen === 1 ? 'checked' : '' %>> Verlassen</label>
        <label><input type="checkbox" class="form-check-input" data-inline-field="behinderung" <%= r.behinderung === 1 ? 'checked' : '' %>> Behinderung</label>
        <input type="text" class="form-control form-control-sm inline-input inline-sub" data-inline-field="behinderung_text"
               value="<%= r.behinderung_text || '' %>" placeholder="Wer wurde wie behindert?" maxlength="2000"
               <%= r.behinderung === 1 ? '' : 'hidden' %> aria-label="Behinderung beschreiben">
      </div>
    <% } else { %>
      <div class="<%= extras.length ? 'text-truncate' : 'clamp-2' %>" title="<%= r.verstoss_art || '' %>"><%= r.verstoss_art || '' %></div>
    <% } %>
    <% if (extras.length) { %>
      <div class="cell-sub text-muted small text-truncate" title="<%= extras.join(' · ') %>"><%= extras.join(' · ') %></div>
    <% } %>
  </td>
  <td class="cell-status">
    <% if (r.status === 'versendet') { %>
      <span class="badge rounded-pill text-bg-success">Versendet</span>
    <% } else if (_isDraft) { %>
      <%# Status Entwurf ⇄ Bereit per Klick umschalten (report-table.js). „Bereit"
          ist eine Markierung am Entwurf (bereit_at) – bleibt also voll bearbeitbar. %>
      <form method="post" action="/anzeige/<%= r.aktenzeichen %>/bereit" class="d-inline m-0" data-bereit-toggle>
        <button type="submit" class="badge rounded-pill border-0 <%= r.bereit_at ? 'text-bg-primary' : 'text-bg-warning' %>"
                title="<%= r.bereit_at ? 'Bereit zum Einreichen – Klick: zurück auf Entwurf' : 'Entwurf – Klick: als bereit markieren' %>"><%= r.bereit_at ? '✔ Bereit' : 'Entwurf' %></button>
      </form>
      <% const _vj = verjaehrung(r) %>
      <% if (_vj.verjaehrt) { %>
        <span class="badge rounded-pill text-bg-danger" title="<%= _vj.text %>">⌛ <%= _vj.monate < 3 ? 'Frist abgelaufen' : 'Verjährt' %></span>
      <% } else if (_vj.bald) { %>
        <span class="badge rounded-pill text-bg-light border" title="<%= _vj.monate < 3 ? 'Annahmefrist der Stadt endet' : 'Verjährt' %> in <%= _vj.restTage %> Tag<%= _vj.restTage === 1 ? '' : 'en' %>">⏳ noch <%= _vj.restTage %> T.</span>
      <% } %>
    <% } else { %>
      <%# Eingereicht: wo steht der Versand? versand_warte = wartender/laufender
          Versand-Job (services/versandWarte.ts), der Versand-Takt lässt ihn oft
          Minuten warten. Countdown + Nachladen der Zeile: report-table.js. %>
      <% const _w = r.versand_warte %>
      <% if (r.versand_status || (_w && (_w.laeuft || !_w.sek))) { %>
        <span class="badge rounded-pill text-bg-primary" data-versand-live title="Die Anzeige wird gerade ans Ordnungsamt übermittelt.">📤 Versand läuft</span>
      <% } else if (_w && _w.sek) { %>
        <span class="badge rounded-pill text-bg-info" data-versand-live data-versand-in="<%= _w.sek %>"
              title="Die Anzeigen werden nacheinander im Abstand verschickt.">⏱ Versand in <span data-versand-uhr><%= h.mmss(_w.sek) %></span></span>
      <% } else { %>
        <span class="badge rounded-pill text-bg-info" title="Eingereicht – wird geprüft und dann ans Ordnungsamt verschickt.">Eingereicht</span>
      <% } %>
    <% } %>
    <% if (typeof isDuplicate !== 'undefined' && isDuplicate) { %>
      <span class="badge rounded-pill text-bg-warning border border-dark-subtle" title="Gleiches Kennzeichen im selben Zeitraum – siehe Hinweis oben">⚠️ Doppelt?</span>
    <% } %>
    <%# Antwort des Ordnungsamts liegt vor (Spalten liefert nur das Dashboard). %>
    <% if (r.reply_count) { %>
      <a href="/anzeige/<%= r.aktenzeichen %>" class="badge rounded-pill text-bg-primary text-decoration-none"
         title="Antwort des Ordnungsamts ansehen">
        📨 Antwort<%= r.reply_count > 1 ? ' (' + r.reply_count + ')' : '' %><%= r.unread_reply_count > 0 ? ' • neu' : '' %>
      </a>
    <% } %>
  </td>
  <td class="cell-actions">
    <div class="d-flex gap-1 justify-content-end">
      <% if (_isDraft) { %>
        <%# ✏️ öffnet den Prüf-Dialog (report-modal.js → photo-edit.js); ohne Fotos den alten Editor. %>
        <%# Prüfen: öffnet den Prüf-Dialog (photo-edit.js) auf dem ersten ungeprüften
            Foto – Fotos schwärzen, Angaben kontrollieren, dort einreichen. Ohne
            Fotos fällt der Klick auf die Einreichen-Vorschau (report-submit.js) zurück. %>
        <% if (!_verjaehrt) { %><button type="button" class="btn btn-sm btn-success" data-review-photos title="<%= _unchecked ? _unchecked + ' von ' + _imgs.length + ' Fotos ungeprüft – ' : '' %>Fotos prüfen, Angaben kontrollieren und einreichen">Prüfen<% if (_unchecked) { %> <span class="badge text-bg-warning"><%= _unchecked %></span><% } %></button><% } %>
        <a href="/anzeige/<%= r.aktenzeichen %>/bearbeiten<%= _queue %>" class="btn btn-sm btn-outline-primary" data-edit-modal title="Bearbeiten (Prüf-Dialog)">✏️</a>
        <%# Löschen verschiebt in den Papierkorb (wiederherstellbar). %>
        <form method="post" action="/anzeige/<%= r.aktenzeichen %>/discard" class="m-0">
          <button type="submit" class="btn btn-sm btn-outline-danger" title="In den Papierkorb" aria-label="Entwurf <%= r.aktenzeichen %> in den Papierkorb verschieben">🗑</button>
        </form>
      <% } else { %>
        <a href="/anzeige/<%= r.aktenzeichen %>" class="btn btn-sm btn-outline-secondary">Details</a>
      <% } %>
    </div>
  </td>
  <% if (_isDraft) { %>
  <%# Nur Handy (app.css): Entwürfe sind dort zugeklappt – statt elf Eingabefeldern
      je Karte steht hier eine Zusammenfassung; Tippen klappt die Inline-Felder
      auf (.is-open, report-table.js). Bewusst die letzte Zelle, damit die
      nth-child-Spaltenbreiten der Tabelle (Desktop, dort ausgeblendet) stimmen. %>
  <td class="cell-summary">
    <% const _fzKurz = [r.fahrzeug_marke, r.fahrzeug_modell].filter(Boolean).join(' ') || r.fahrzeug_farbe || '' %>
    <% const _zeit = r.tattag ? h.fmtDate(r.tattag) + (r.tatzeit_von ? ', ' + _hhmm(r.tatzeit_von) : '') : '' %>
    <button type="button" class="draft-summary" data-draft-toggle aria-expanded="false"
            aria-label="Angaben von <%= r.aktenzeichen %> bearbeiten">
      <span class="draft-summary-line">
        <% if (r.kennzeichen) { %><%- h.plate(r.kennzeichen, r.kennzeichen_land) %><% } else { %><span class="draft-missing">Kennzeichen fehlt</span><% } %>
        <% if (_fzKurz) { %><span class="draft-summary-fz"><%= _fzKurz %></span><% } %>
      </span>
      <span class="draft-summary-line<%= r.verstoss_art ? '' : ' draft-missing' %>"><span class="draft-summary-ico" aria-hidden="true">🚫</span><span class="text-truncate"><%= r.verstoss_art || 'Verstoß fehlt' %></span></span>
      <span class="draft-summary-line text-body-secondary">
        <span class="draft-summary-ico" aria-hidden="true">🕒</span><span class="<%= _zeit ? '' : 'draft-missing' %>"><%= _zeit || 'Zeit fehlt' %></span>
        <span class="draft-summary-ico ms-2" aria-hidden="true">📍</span><span class="text-truncate<%= r.tatort ? '' : ' draft-missing' %>"><%= r.tatort ? String(r.tatort).split(',')[0] : 'Tatort fehlt' %></span>
      </span>
      <span class="draft-summary-more"><span class="draft-summary-open">Angaben bearbeiten</span><span class="draft-summary-close">Zuklappen</span> <span class="draft-chevron" aria-hidden="true">›</span></span>
    </button>
  </td>
  <% } %>
</tr>
